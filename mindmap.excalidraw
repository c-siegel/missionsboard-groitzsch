nsparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vt","roundness":null,"seed":274776238,"version":156,"versionNonce":1693433193,"isDeleted":false,"boundElements":[{"type":"text","id":"uUhNHLU7mmOGtdzMioJ61"},{"id":"iqMjhyaAWvtz5dKVYSqjO","type":"arrow"},{"id":"XtH60A4ez3TSHcOMApTf8","type":"arrow"}],"updated":1794738480830,"created":1791538117279,"link":null,"locked":false},{"id":"uUhNHLU7mmOGtdzMioJ61","type":"text","x":-499.30197901717366,"y":169.92351611724408,"width":131.2984550869054,"height":58.735080514258264,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vv","roundness":null,"seed":1337855470,"version":71,"versionNonce":1543088583,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791538186952,"link":null,"locked":false,"text":"Wie kann das Problem mit den\nTreibhausgasen und den steigenden\nTemperaturen gelöst werden?\n\nCeline sagt zuversichtlich: „Die Natur\nregelt das schon, wofür gibt es denn die\nMeere?“  ","fontSize":6.712580630200945,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"yt-pjR8aeKPutB6yq8bwp","originalText":"Wie kann das Problem mit den Treibhausgasen und den steigenden Temperaturen gelöst werden?\n\nCeline sagt zuversichtlich: „Die Natur regelt das schon, wofür gibt es denn die Meere?“  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"-OtgjPsBKd0Z5XbUTi1kp","type":"rectangle","x":-561.4329619121129,"y":288.1766503845138,"width":117.48588575772035,"height":80,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vx","roundness":null,"seed":2115463534,"version":332,"versionNonce":607643817,"isDeleted":false,"boundElements":[{"type":"text","id":"_4I5XyTWmx7PzmW9j6X9_"},{"id":"XtH60A4ez3TSHcOMApTf8","type":"arrow"},{"id":"EBZLX0Bq8-TEU7QNw6Bv6","type":"arrow"}],"updated":1794738480830,"created":1791538203451,"link":null,"locked":false},{"id":"_4I5XyTWmx7PzmW9j6X9_","type":"text","x":-554.4700178125496,"y":293.2105054166957,"width":103.55999755859375,"height":69.93228993563625,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3w","roundness":null,"seed":1989042926,"version":119,"versionNonce":738283177,"isDeleted":false,"boundElements":[],"updated":1794409470393,"created":1791538204436,"link":null,"locked":false,"text":"Was meint sie damit?\n\nWie soll Wasser die\nLösung für die steigende\nCO2-Konzentration in\nunserer Luft sein?  ","fontSize":9.324305324751501,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"-OtgjPsBKd0Z5XbUTi1kp","originalText":"Was meint sie damit?\n\nWie soll Wasser die Lösung für die steigende CO2-Konzentration in unserer Luft sein?  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"IkAci99NeEGGfPM3ju9nU","type":"rectangle","x":-717.619264688328,"y":448.19453030210576,"width":202.6474334154037,"height":157.86597238526258,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3w4","roundness":null,"seed":268372018,"version":160,"versionNonce":1532059785,"isDeleted":false,"boundElements":[{"type":"text","id":"Amtein2m4yNJZV7JEvEOb"},{"id":"EBZLX0Bq8-TEU7QNw6Bv6","type":"arrow"},{"id":"k4BeMB3Ri4OUsmCiWb06o","type":"arrow"}],"updated":1794738480830,"created":1791538216966,"link":null,"locked":false},{"id":"Amtein2m4yNJZV7JEvEOb","type":"text","x":-712.619264688328,"y":457.47626397731585,"width":192.6474334154037,"height":139.30250503484245,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3w8","roundness":null,"seed":281122670,"version":85,"versionNonce":720268039,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791538218130,"link":null,"locked":false,"text":"Kohlenstoffdioxid kann in Wasser gelöst\nwerden, wie ihr es vom Sprudelwasser kennt.\n\nBei Sprudelwasser wird das CO2\nreingepumpt (z. B. mit einem \"Sodastream\").\nMüssen wir also nur das CO2 aus der\nAtmosphäre in die Meere pumpen, um das\nProblem zu lösen?\n\nUm einzuschätzen, ob sich das lohnt, sollten\nwir uns die natürliche Bewegung der\nGasteilchen anschauen.  ","fontSize":9.286833668989496,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"IkAci99NeEGGfPM3ju9nU","originalText":"Kohlenstoffdioxid kann in Wasser gelöst werden, wie ihr es vom Sprudelwasser kennt.\n\nBei Sprudelwasser wird das CO2 reingepumpt (z. B. mit einem \"Sodastream\"). Müssen wir also nur das CO2 aus der Atmosphäre in die Meere pumpen, um das Problem zu lösen?\n\nUm einzuschätzen, ob sich das lohnt, sollten wir uns die natürliche Bewegung der Gasteilchen anschauen.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"MVGOOXY58ygqeOtVmwP30","type":"rectangle","x":-846.7284670563337,"y":1053.6188982789474,"width":212.8672876954801,"height":282.71989957927815,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wK","roundness":null,"seed":1423991986,"version":174,"versionNonce":74144457,"isDeleted":false,"boundElements":[{"type":"text","id":"MDST9gr3fD7ADkyXNv8nH"},{"id":"v10M1Pq9DJ6OQ0lbPukoO","type":"arrow"},{"id":"jPv0qkcTRuQuewJaWum_N","type":"arrow"}],"updated":1794738480830,"created":1791538285555,"link":null,"locked":false},{"id":"MDST9gr3fD7ADkyXNv8nH","type":"text","x":-832.4748235137694,"y":1058.6188982789474,"width":184.36000061035156,"height":60.45811176307407,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wO","roundness":null,"seed":218042738,"version":119,"versionNonce":850525129,"isDeleted":false,"boundElements":[],"updated":1794409657055,"created":1791538286506,"link":null,"locked":false,"text":"\nDie Bewegung der Gasteilchen stoppt nie, jedoch\nergibt sich irgendwann ein Punkt, an dem der\nLösevorgang und die Freisetzung des Gases gleich\nschnell ablaufen. Dieser Punkt wird Gleichgewicht\ngenannt.","fontSize":8.061081568409877,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"MVGOOXY58ygqeOtVmwP30","originalText":"\nDie Bewegung der Gasteilchen stoppt nie, jedoch ergibt sich irgendwann ein Punkt, an dem der Lösevorgang und die Freisetzung des Gases gleich schnell ablaufen. Dieser Punkt wird Gleichgewicht genannt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"D4Tiujl0uTt7V499lxL_O","type":"rectangle","x":-1115.4668664290307,"y":1191.7847352204046,"width":168.99073209321168,"height":168.99073209321168,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wV","roundness":null,"seed":1014330226,"version":75,"versionNonce":1165502665,"isDeleted":false,"boundElements":[{"type":"text","id":"el-SaRYf860c98YR6hrv-"},{"id":"jPv0qkcTRuQuewJaWum_N","type":"arrow"},{"id":"aICKOPMbmv9ZME1dhlZ1j","type":"arrow"}],"updated":1794738480830,"created":1791538345309,"link":null,"locked":false},{"id":"el-SaRYf860c98YR6hrv-","type":"text","x":-1110.3614997720733,"y":1213.3253773816507,"width":158.77999877929688,"height":125.90944777071942,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wZ","roundness":null,"seed":1433601650,"version":43,"versionNonce":1800342729,"isDeleted":false,"boundElements":[],"updated":1794409809084,"created":1791538346086,"link":null,"locked":false,"text":"Im Gleichgewicht liegt eine konstante\nKonzentration von Kohlenstoffdioxid in\nder Flüssigkeit vor, die\nSättigungskonzentration.\n\nDie Sättigungskonzentration ist abhängig\nvon der Menge an Kohlenstoffdioxid in\nder Flüssigkeit und dem (Partial-)Druck in\nder Gasphase (Bereich mit Gas) über der\nFlüssigkeit. Dieser Druck ist abhängig von\nder Menge des Kohlenstoffdioxides in der\nGasphase, aber auch von der Temperatur.","fontSize":8.393963184714629,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"D4Tiujl0uTt7V499lxL_O","originalText":"Im Gleichgewicht liegt eine konstante Konzentration von Kohlenstoffdioxid in der Flüssigkeit vor, die Sättigungskonzentration.\n\nDie Sättigungskonzentration ist abhängig von der Menge an Kohlenstoffdioxid in der Flüssigkeit und dem (Partial-)Druck in der Gasphase (Bereich mit Gas) über der Flüssigkeit. Dieser Druck ist abhängig von der Menge des Kohlenstoffdioxides in der Gasphase, aber auch von der Temperatur.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"QNDpO2-46ZhL4KszV_PWw","type":"rectangle","x":-1246.0855265746113,"y":1444.6579527040324,"width":140.48418673033242,"height":81.21742045347342,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wd","roundness":null,"seed":1993083122,"version":213,"versionNonce":85819207,"isDeleted":false,"boundElements":[{"type":"text","id":"hffNF86TKam8XfKDoQ-Tz"},{"id":"aICKOPMbmv9ZME1dhlZ1j","type":"arrow"},{"id":"tCtxv0_r1WVwJvZCS75jZ","type":"arrow"}],"updated":1794738480830,"created":1791538360773,"link":null,"locked":false},{"id":"hffNF86TKam8XfKDoQ-Tz","type":"text","x":-1238.3322621665022,"y":1457.100214572645,"width":124.97765791411446,"height":56.33289671624817,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wl","roundness":null,"seed":1348456562,"version":139,"versionNonce":1740839495,"isDeleted":false,"boundElements":[],"updated":1794409814284,"created":1791538361470,"link":null,"locked":false,"text":"Je mehr Kohlenstoffdioxid in der\nGasphase ist, desto größer ist der\nPartialdruck und umso höher ist die\nSättigungskonzentration. Somit kann\nmehr Kohlenstoffdioxid gelöst\nwerden.  ","fontSize":7.511052895499757,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"QNDpO2-46ZhL4KszV_PWw","originalText":"Je mehr Kohlenstoffdioxid in der Gasphase ist, desto größer ist der Partialdruck und umso höher ist die Sättigungskonzentration. Somit kann mehr Kohlenstoffdioxid gelöst werden.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"hM0Vn52jk_w1Gtz4WR_sd","type":"rectangle","x":-1487.9238774380474,"y":1342.3589581790754,"width":164.18403579621398,"height":91.51240098714878,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wp","roundness":null,"seed":43650094,"version":264,"versionNonce":1249284809,"isDeleted":false,"boundElements":[{"type":"text","id":"IKqDwW0uWzyKH-Mn5CaTq"},{"id":"tCtxv0_r1WVwJvZCS75jZ","type":"arrow"},{"id":"hvcHiuJ63H1pdF9sYfImL","type":"arrow"}],"updated":1794738480830,"created":1791538380963,"link":null,"locked":false},{"id":"IKqDwW0uWzyKH-Mn5CaTq","type":"text","x":-1482.9238774380474,"y":1358.51194283391,"width":154.18403579621398,"height":59.20643167747967,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wt","roundness":null,"seed":1825279982,"version":161,"versionNonce":1930694599,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791538381824,"link":null,"locked":false,"text":"Also scheint Celine ja recht zu haben?  \nWenn mehr CO2 in die Atmosphäre\ngelangt, bewegen sich auch mehr\nGasteilchen ins Wasser. Die Ozeane\nspeichern also einen Teil unseres\nerzeugten CO2.  ","fontSize":7.894190890330622,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"hM0Vn52jk_w1Gtz4WR_sd","originalText":"Also scheint Celine ja recht zu haben?   Wenn mehr CO2 in die Atmosphäre gelangt, bewegen sich auch mehr Gasteilchen ins Wasser. Die Ozeane speichern also einen Teil unseres erzeugten CO2.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"Pj3rRicX0F1UsGiv6O7N4","type":"rectangle","x":-1411.6354610662338,"y":1109.1371850972603,"width":166.55323533550032,"height":123.19025561461515,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3x","roundness":null,"seed":344202482,"version":211,"versionNonce":206925225,"isDeleted":false,"boundElements":[{"type":"text","id":"i6CiyPFR7L7Z4A-LEirqK"},{"id":"hvcHiuJ63H1pdF9sYfImL","type":"arrow"},{"id":"7PWbonxxfbwYwsBxQaegd","type":"arrow"}],"updated":1794738480830,"created":1791538399598,"link":null,"locked":false},{"id":"i6CiyPFR7L7Z4A-LEirqK","type":"text","x":-1406.6354610662338,"y":1132.7945109072891,"width":156.55323533550032,"height":75.87560399455745,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3x8","roundness":null,"seed":360876654,"version":128,"versionNonce":407449575,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791538400416,"link":null,"locked":false,"text":"Hat der steigende Meeresspiegel\naufgrund der weiterhin\nsteigenden Temperaturen also\nvielleicht doch auch einen Vorteil?\nImmerhin kann so mehr CO2\ngespeichert werden.  ","fontSize":10.116747199274327,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"Pj3rRicX0F1UsGiv6O7N4","originalText":"Hat der steigende Meeresspiegel aufgrund der weiterhin steigenden Temperaturen also vielleicht doch auch einen Vorteil? Immerhin kann so mehr CO2 gespeichert werden.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"MhGiAIHVE8q6HEEgBVyPz","type":"rectangle","x":-1507.0664224161737,"y":884.8050877102863,"width":238.93781278307742,"height":146.75700409195943,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xG","roundness":null,"seed":2099732530,"version":89,"versionNonce":830225897,"isDeleted":false,"boundElements":[{"type":"text","id":"ybveiIvl1tuJL8p339z8F"},{"id":"HF1QCpXU7XlPTPXQlD5Iq","type":"arrow"}],"updated":1794738480830,"created":1791538416196,"link":null,"locked":false},{"id":"ybveiIvl1tuJL8p339z8F","type":"text","x":-1502.0664224161737,"y":913.9321680714871,"width":228.93781278307742,"height":88.50284336955781,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xV","roundness":null,"seed":365131438,"version":68,"versionNonce":1343762983,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791538416993,"link":null,"locked":false,"text":"Schaut euch das folgende Experiment an, bei dem die Löslichkeit von\nCO2 in Wasser untersucht wird.\n\nAls Maß für die Menge an gelöstem Kohlenstoffdioxid wird der\npH-Wert verwendet. CO2 reagiert mit Wasser zu Kohlensäure, welche\nin Wasser gelöst einen niedrigen pH-Wert hat. \n\nJe niedriger der pH-Wert ist, desto mehr Kohlensäure liegt vor und\ndesto mehr CO2 ist gelöst. Umgekehrt bedeutet ein höherer pH-Wert,\ndass im Vergleich weniger CO2 gelöst ist.  ","fontSize":7.080227469564624,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"MhGiAIHVE8q6HEEgBVyPz","originalText":"Schaut euch das folgende Experiment an, bei dem die Löslichkeit von CO2 in Wasser untersucht wird.\n\nAls Maß für die Menge an gelöstem Kohlenstoffdioxid wird der pH-Wert verwendet. CO2 reagiert mit Wasser zu Kohlensäure, welche in Wasser gelöst einen niedrigen pH-Wert hat. \n\nJe niedriger der pH-Wert ist, desto mehr Kohlensäure liegt vor und desto mehr CO2 ist gelöst. Umgekehrt bedeutet ein höherer pH-Wert, dass im Vergleich weniger CO2 gelöst ist.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"asykhI_265XWZuXaJnKK7","type":"rectangle","x":-1348.916965665981,"y":650.107348702699,"width":352.7304530056869,"height":187.04008845415828,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xd","roundness":null,"seed":1878137902,"version":1252,"versionNonce":1457035273,"isDeleted":false,"boundElements":[{"type":"text","id":"MN8cIli2wbAw_1IMNMaX8"},{"id":"HF1QCpXU7XlPTPXQlD5Iq","type":"arrow"},{"id":"p28ib4RCdzcU4AHHagqUk","type":"arrow"},{"id":"nuCZ0XxH9l5Uiqjp3jGHP","type":"arrow"}],"updated":1794738480830,"created":1791538428767,"link":null,"locked":false},{"id":"MN8cIli2wbAw_1IMNMaX8","type":"text","x":-1343.916965665981,"y":666.2054107876704,"width":338.7200012207031,"height":154.84396428421553,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xl","roundness":null,"seed":1296670002,"version":682,"versionNonce":1857846313,"isDeleted":false,"boundElements":[],"updated":1794409902879,"created":1791538429552,"link":null,"locked":false,"text":"Experiment H: Temperatur, Wasser und CO2\n\nAnleitung: \n1.) Füllt ca. 20 ml Sprudelwasser in das Becherglas und färbt es mit 4 Tropfen\nIndikatorlösung ein. \n2.) Gießt davon ca. 10 ml in ein Reagenzglas und ordnet der Farbe der Lösung mit Hilfe der\nFarbkarte den richtigen pH-Wert zu. \n3.) Stellt das Becherglas mit der restlichen Lösung auf die Heizplatte. \n4.) Steckt die Heizplatte ein und erhitzt das Wasser unter ständigem Rühren für ca. 2 min\nbis eine eindeutige Änderung der Farbe eintritt. Beobachtet, welche Farbänderung der\nLösung eintritt. \n5.) Schaltet nun die Heizplatte aus und füllt die warme Lösung um in ein zweites\nReagenzglas. Vorsicht: Becherglas nur oben am Rand anfassen! \n6.) Ordnet der erhitzten Lösung den pH-Wert zu und notiert ihn. \n7.) Gießt die Flüssigkeiten ins Waschbecken.  ","fontSize":8.258344761824828,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"asykhI_265XWZuXaJnKK7","originalText":"Experiment H: Temperatur, Wasser und CO2\n\nAnleitung: \n1.) Füllt ca. 20 ml Sprudelwasser in das Becherglas und färbt es mit 4 Tropfen Indikatorlösung ein. \n2.) Gießt davon ca. 10 ml in ein Reagenzglas und ordnet der Farbe der Lösung mit Hilfe der Farbkarte den richtigen pH-Wert zu. \n3.) Stellt das Becherglas mit der restlichen Lösung auf die Heizplatte. \n4.) Steckt die Heizplatte ein und erhitzt das Wasser unter ständigem Rühren für ca. 2 min bis eine eindeutige Änderung der Farbe eintritt. Beobachtet, welche Farbänderung der Lösung eintritt. \n5.) Schaltet nun die Heizplatte aus und füllt die warme Lösung um in ein zweites Reagenzglas. Vorsicht: Becherglas nur oben am Rand anfassen! \n6.) Ordnet der erhitzten Lösung den pH-Wert zu und notiert ihn. \n7.) Gießt die Flüssigkeiten ins Waschbecken.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"-xgCxSVR0C507ttdJ9O2C","type":"rectangle","x":-1096.6850118463194,"y":450.41417281425083,"width":137.08395838534534,"height":98.97092543238945,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3y","roundness":null,"seed":386622446,"version":405,"versionNonce":1517743463,"isDeleted":false,"boundElements":[{"type":"text","id":"7IHPuL7idbZObKyCIiVf2"},{"id":"GEKMxU-PzMfRoIs9rPLgK","type":"arrow"}],"updated":1794738480830,"created":1791538583208,"link":"https://www.geogebra.org/m/r8gny4uc","locked":false},{"id":"7IHPuL7idbZObKyCIiVf2","type":"text","x":-1089.5130315855315,"y":465.39813214613866,"width":122.73999786376953,"height":69.00300676861374,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3yG","roundness":null,"seed":1780491058,"version":408,"versionNonce":264205097,"isDeleted":false,"boundElements":[],"updated":1794409951311,"created":1791538583950,"link":null,"locked":false,"text":"Aufgabe 2: Erschließt euch den\nZusammenhang, indem ihr den\nLückentext löst, der sich beim\nTippen auf diese Kachel öffnet.\n\nÜbertragt die Lücken ins\nProjektheft, wenn alles richtig ist.  ","fontSize":7.886057916413001,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"-xgCxSVR0C507ttdJ9O2C","originalText":"Aufgabe 2: Erschließt euch den Zusammenhang, indem ihr den Lückentext löst, der sich beim Tippen auf diese Kachel öffnet.\n\nÜbertragt die Lücken ins Projektheft, wenn alles richtig ist.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"VpuFy3y8SpmHwwF4PrCh_","type":"rectangle","x":-923.5353449172878,"y":206.343294142981,"width":195.17318518877207,"height":188.4921508844234,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3yV","roundness":null,"seed":729801518,"version":194,"versionNonce":446962793,"isDeleted":false,"boundElements":[{"type":"text","id":"TlmU2TaRuTKePWJQwoHss"},{"id":"GEKMxU-PzMfRoIs9rPLgK","type":"arrow"},{"id":"ew3lyVh1123yytN64Dyzv","type":"arrow"}],"updated":1794738480830,"created":1791538599759,"link":"https://www.geogebra.org/m/fe66jkmb","locked":false},{"id":"TlmU2TaRuTKePWJQwoHss","type":"text","x":-915.2287511021987,"y":232.55962120755333,"width":178.55999755859375,"height":136.0594967552787,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3z","roundness":null,"seed":1948993262,"version":244,"versionNonce":666517993,"isDeleted":false,"boundElements":[],"updated":1794410025185,"created":1791538600587,"link":null,"locked":false,"text":"Mit steigenden Temperaturen durch die globale\nErwärmung ist das Meer als CO2-Speicher also\nimmer ineffektiver, genau wie eine Limo in der\nsommerlichen Hitze schnell den Sprudel verliert.\nDadurch ist mehr CO2 in der Atmosphäre, welches\nals Treibhausgas die globale Erwärmung\nbeeinflusst. Es entsteht ein Kreislauf.\n\nAufgabe 3: Ordnet nun die einzelnen Schritte, um\nden Kreislauf darzustellen. Öffnet dafür die\nAktivität, indem ihr auf diese Kachel tippt.\n\nÜbertragt die Lücken wieder ins Projektheft, wenn\nalles richtig ist.  ","fontSize":7.774828386015926,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"VpuFy3y8SpmHwwF4PrCh_","originalText":"Mit steigenden Temperaturen durch die globale Erwärmung ist das Meer als CO2-Speicher also immer ineffektiver, genau wie eine Limo in der sommerlichen Hitze schnell den Sprudel verliert. Dadurch ist mehr CO2 in der Atmosphäre, welches als Treibhausgas die globale Erwärmung beeinflusst. Es entsteht ein Kreislauf.\n\nAufgabe 3: Ordnet nun die einzelnen Schritte, um den Kreislauf darzustellen. Öffnet dafür die Aktivität, indem ihr auf diese Kachel tippt.\n\nÜbertragt die Lücken wieder ins Projektheft, wenn alles richtig ist.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"KI2AYegzG6bTTH-5Q9uQm","type":"rectangle","x":-692.4640660060686,"y":82.035216689621,"width":95.57378413282004,"height":74.14850508871675,"angle":0,"strokeColor":"transparent","backgroundColor":"#b58cc9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3zV","roundness":null,"seed":1557183598,"version":295,"versionNonce":2137738407,"isDeleted":false,"boundElements":[{"type":"text","id":"PwQIuA7v2qLHoWrDNuY7B"},{"id":"ew3lyVh1123yytN64Dyzv","type":"arrow"},{"id":"tB5dOSLfpOkuq6jytFk3k","type":"arrow"}],"updated":1794738480830,"created":1791538608471,"link":null,"locked":false},{"id":"PwQIuA7v2qLHoWrDNuY7B","type":"text","x":-684.8471721086039,"y":92.48952495923015,"width":80.33999633789062,"height":53.239888549498446,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b40","roundness":null,"seed":616632370,"version":250,"versionNonce":1930786279,"isDeleted":false,"boundElements":[],"updated":1794410033298,"created":1791538609077,"link":null,"locked":false,"text":"Nun kennt ihr die\nZusammenhänge und\nkönnt euch selbst\nüberlegen, ob die Meere\nallein unser bestehendes\nProblem lösen könnten.  ","fontSize":7.098651806599793,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"KI2AYegzG6bTTH-5Q9uQm","originalText":"Nun kennt ihr die Zusammenhänge und könnt euch selbst überlegen, ob die Meere allein unser bestehendes Problem lösen könnten.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"p7p9e8acKEeybVvBGZalM","type":"rectangle","x":-760.2744937271486,"y":-227.26554942246617,"width":186.6284925197148,"height":186.6284925197148,"angle":0,"strokeColor":"transparent","backgroundColor":"#fee76d","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b42","roundness":null,"seed":1368067570,"version":136,"versionNonce":684032807,"isDeleted":false,"boundElements":[{"type":"text","id":"kbBYC_obLJw_ituLdRmcF"},{"id":"pOVPwHYmM9ff1PC4_RCgj","type":"arrow"},{"id":"GlwzNGwqO9PBDX9GUV1n8","type":"arrow"}],"updated":1794738480830,"created":1791539259406,"link":null,"locked":false},{"id":"kbBYC_obLJw_ituLdRmcF","type":"text","x":-755.2744937271486,"y":-205.88234168068988,"width":176.6284925197148,"height":143.86207703616225,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b43","roundness":null,"seed":155719474,"version":106,"versionNonce":780371655,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791539260102,"link":null,"locked":false,"text":"Wir sind das einzige Land in der EU\nohne generelles Tempolimit auf den\nAutobahnen. Die Einführung wird\nimmer wieder diskutiert. \n\nAnscheinend gibt es einen\nUnterschied, wenn Autos mit\nunterschiedlichen Geschwindigkeiten\nfahren. Neben Sicherheitsaspekten\nspielt der Kraftstoffverbrauch eine\nwichtige Rolle.  ","fontSize":10.46269651172089,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"p7p9e8acKEeybVvBGZalM","originalText":"Wir sind das einzige Land in der EU ohne generelles Tempolimit auf den Autobahnen. Die Einführung wird immer wieder diskutiert. \n\nAnscheinend gibt es einen Unterschied, wenn Autos mit unterschiedlichen Geschwindigkeiten fahren. Neben Sicherheitsaspekten spielt der Kraftstoffverbrauch eine wichtige Rolle.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"gnVikmiSdzz0z-O47C58-","type":"rectangle","x":-1515.0716186450525,"y":-69.86316850465835,"width":340.2418210822306,"height":364.6169098060595,"angle":0,"strokeColor":"transparent","backgroundColor":"#fee76d","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b48","roundness":null,"seed":1320690030,"version":234,"versionNonce":1929629383,"isDeleted":false,"boundElements":[{"id":"6c45yMgJsd9PpLk9eqYy5","type":"text"},{"id":"xbMLKR12XemX1X998VPE1","type":"arrow"},{"id":"gBbJdwEDSx-icBoyvpnSy","type":"arrow"}],"updated":1794738480830,"created":1791539286788,"link":null,"locked":false},{"id":"6c45yMgJsd9PpLk9eqYy5","type":"text","x":-1510.0716186450525,"y":-64.86316850465835,"width":330.2418210822306,"height":169.10365510412416,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b49","roundness":null,"seed":866163058,"version":186,"versionNonce":821244841,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791539287507,"link":null,"locked":false,"text":"\nNun wisst ihr, wie man mit bewussten Entscheidungen\nCO2 im Verkehr einsparen kann. \n\nAuch für andere Aspekte in unserem Leben ist es recht\neinfach das erzeugte CO2 zu reduzieren, welches im\nZusammenhang mit dem eigenen Lebensstandard\n(Wohnung, Essen, Kleidung) erzeugt wird.\n\nEin Weg ist, die Hilfe von Apps zu nutzen. Das wird im\nfolgenden Video einmal vorgestellt. ","fontSize":12.298447643936301,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"gnVikmiSdzz0z-O47C58-","originalText":"\nNun wisst ihr, wie man mit bewussten Entscheidungen CO2 im Verkehr einsparen kann. \n\nAuch für andere Aspekte in unserem Leben ist es recht einfach das erzeugte CO2 zu reduzieren, welches im Zusammenhang mit dem eigenen Lebensstandard (Wohnung, Essen, Kleidung) erzeugt wird.\n\nEin Weg ist, die Hilfe von Apps zu nutzen. Das wird im folgenden Video einmal vorgestellt. ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"JphcwLJD_o7sRrShKCaU-","type":"rectangle","x":-1919.8118939155154,"y":83.05214460330023,"width":262.7636926969337,"height":167.43905202781997,"angle":0,"strokeColor":"transparent","backgroundColor":"#fee76d","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4A","roundness":null,"seed":1576600366,"version":447,"versionNonce":1699505321,"isDeleted":false,"boundElements":[{"type":"text","id":"KiIRw4vxuOULLgAlTwUCV"},{"id":"gBbJdwEDSx-icBoyvpnSy","type":"arrow"},{"id":"FmtoS52Ra6AiboK0PeLV9","type":"arrow"}],"updated":1794738480830,"created":1791539309544,"link":"https://interaktiv.tagesspiegel.de/lab/co2-bilanz-von-essen-der-klimarechner-fuer-deine-kueche/","locked":false},{"id":"KiIRw4vxuOULLgAlTwUCV","type":"text","x":-1914.8118939155154,"y":96.54303909447017,"width":252.76369269693367,"height":140.4572630454801,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4B","roundness":null,"seed":710867826,"version":517,"versionNonce":317840039,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791539310413,"link":null,"locked":false,"text":"Die globale Erderwärmung zu stoppen ist wichtig für die\nZukunft, damit selbst die Kinder unserer Kinder auf keiner\nzerstörten Erde leben müssen. Im Video wurde eine Anpassung\nder Ernährung als Möglichkeit des persönlichen Umweltschutzes\nangesprochen.\n\nAufgabe 2: Untersucht auf der folgenden Website 3 Gerichte\nund ihre CO2-Bilanz pro Portion. Zieht Schlussfolgerungen,\nwelche Lebensmittel gut bzw. schlecht fürs Klima sind und ob es\nüberhaupt Alternativen gibt.\n\nDie Website öffnet sich, wenn ihr auf diese Kachel tippt. Notiert\neure Ergebnisse im Projektheft.","fontSize":8.643523879721853,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"JphcwLJD_o7sRrShKCaU-","originalText":"Die globale Erderwärmung zu stoppen ist wichtig für die Zukunft, damit selbst die Kinder unserer Kinder auf keiner zerstörten Erde leben müssen. Im Video wurde eine Anpassung der Ernährung als Möglichkeit des persönlichen Umweltschutzes angesprochen.\n\nAufgabe 2: Untersucht auf der folgenden Website 3 Gerichte und ihre CO2-Bilanz pro Portion. Zieht Schlussfolgerungen, welche Lebensmittel gut bzw. schlecht fürs Klima sind und ob es überhaupt Alternativen gibt.\n\nDie Website öffnet sich, wenn ihr auf diese Kachel tippt. Notiert eure Ergebnisse im Projektheft.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"3GvXC3nh8i6Ni2TxqKIQb","type":"rectangle","x":-1825.4008910295704,"y":-354.00662800137854,"width":208.55860656473277,"height":266.8085141883362,"angle":0,"strokeColor":"transparent","backgroundColor":"#fee76d","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4E","roundness":null,"seed":733748018,"version":359,"versionNonce":1555681897,"isDeleted":false,"boundElements":[{"type":"text","id":"6AVN8t23GiidmUXtBWsG-"},{"id":"okshMejya5a5cqA3a7D9m","type":"arrow"},{"id":"PJeZpGE_LbZO7LejlT8Wc","type":"arrow"}],"updated":1794738480830,"created":1791539346497,"link":null,"locked":false},{"id":"6AVN8t23GiidmUXtBWsG-","type":"text","x":-1816.671590798962,"y":-349.00662800137854,"width":191.10000610351562,"height":86.2539715992898,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4F","roundness":null,"seed":1742452722,"version":222,"versionNonce":237466343,"isDeleted":false,"boundElements":[],"updated":1794409185665,"created":1791539347367,"link":null,"locked":false,"text":"\nEine Übersicht der durchschnittlichen Emissionen pro\ndeutschem Staatsbürger gibt der sogenannte CO2-\nFußabdruck.\n\nAufgabe 3: Schaut euch den Fußabdruck an und erklärt\nim Projektheft, wie ihr allgemein persönlich CO2\neinsparen könntet und welchen Einfluss die Maßnahme\nauf euer Leben hätte.  ","fontSize":7.6670196977146485,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"3GvXC3nh8i6Ni2TxqKIQb","originalText":"\nEine Übersicht der durchschnittlichen Emissionen pro deutschem Staatsbürger gibt der sogenannte CO2-Fußabdruck.\n\nAufgabe 3: Schaut euch den Fußabdruck an und erklärt im Projektheft, wie ihr allgemein persönlich CO2 einsparen könntet und welchen Einfluss die Maßnahme auf euer Leben hätte.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"m07nV1GgG5NrqqYEkGqK1","type":"rectangle","x":-1522.439751778639,"y":-445.0949082636447,"width":223.80731118729233,"height":122.34024024334784,"angle":0,"strokeColor":"transparent","backgroundColor":"#fee76d","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4G","roundness":null,"seed":1150605230,"version":242,"versionNonce":832199015,"isDeleted":false,"boundElements":[{"type":"text","id":"LGo3GAENG8ohDh2i8hgnz"},{"id":"ZmF1HGUpjSPAIvGiqpIOF","type":"arrow"}],"updated":1794738480830,"created":1791539359638,"link":null,"locked":false},{"id":"LGo3GAENG8ohDh2i8hgnz","type":"text","x":-1517.439751778639,"y":-435.7705676138524,"width":213.80731118729233,"height":103.69155894376327,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4H","roundness":null,"seed":278820014,"version":174,"versionNonce":1120073415,"isDeleted":false,"boundElements":[],"updated":1794738084901,"created":1791539360388,"link":null,"locked":false,"text":"Wenn jeder Mensch seinen Beitrag zur\nSenkung der CO2-Emission leisten würde,\nwürde die globale Erwärmung abgebremst\nwerden.\n\nUm die Erderwärmung aber komplett zu\nstoppen, müsste auch die Politik mehr\nunternehmen.  ","fontSize":10.369155894376327,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"m07nV1GgG5NrqqYEkGqK1","originalText":"Wenn jeder Mensch seinen Beitrag zur Senkung der CO2-Emission leisten würde, würde die globale Erwärmung abgebremst werden.\n\nUm die Erderwärmung aber komplett zu stoppen, müsste auch die Politik mehr unternehmen.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"cefBqTIkfUyjD4KBXw8t2","type":"rectangle","x":-1210.024722722956,"y":-503.5866796818168,"width":411.66322082481173,"height":312.0422246017072,"angle":0,"strokeColor":"transparent","backgroundColor":"#fee76d","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4I","roundness":null,"seed":2047012466,"version":265,"versionNonce":2146353127,"isDeleted":false,"boundElements":[{"type":"text","id":"tIYE1E65ALLRpoUXYBZO6"},{"id":"ZmF1HGUpjSPAIvGiqpIOF","type":"arrow"},{"id":"s-eYKXUJ5LVKT8kV5IyuJ","type":"arrow"}],"updated":1794738480830,"created":1791539371459,"link":null,"locked":false},{"id":"tIYE1E65ALLRpoUXYBZO6","type":"text","x":-1205.024722722956,"y":-498.5866796818168,"width":401.66322082481173,"height":105.82715863496554,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"f