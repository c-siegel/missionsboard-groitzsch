54.750647919149834,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3t1","roundness":null,"seed":110497326,"version":67,"versionNonce":195160551,"isDeleted":false,"boundElements":[],"updated":1794410279082,"created":1791533060967,"link":null,"locked":false,"text":"Ben sagt: \u201eGroitzsch liegt 150 m \u00fcber\ndem Meeresspiegel, also was\ninteressiert mich der kleine Anstieg der\nMeere jedes Jahr?\u201c\n\nOb die Meinung von Ben sinnvoll ist,\nwerdet ihr im Folgenden untersuchen.","fontSize":6.257216905045696,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"dJfmPGN98jt_2HkDxELmB","originalText":"Ben sagt: \u201eGroitzsch liegt 150 m \u00fcber dem Meeresspiegel, also was interessiert mich der kleine Anstieg der Meere jedes Jahr?\u201c\n\nOb die Meinung von Ben sinnvoll ist, werdet ihr im Folgenden untersuchen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"ailSy3b2lBw3tXHKFv28A","type":"rectangle","x":-1062.0981737412226,"y":-737.3772800299804,"width":103.7608770479409,"height":103.7608770479409,"angle":0,"strokeColor":"transparent","backgroundColor":"#a1c6fa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3t4","roundness":null,"seed":1635601778,"version":83,"versionNonce":1322410453,"isDeleted":false,"boundElements":[{"type":"text","id":"QRKWGxq111tnpKIir1KDT"},{"id":"2mDTMnEpKcOz13SYmvJsh","type":"arrow"},{"id":"ipFKgsyeeopGwIqr7imJ5","type":"arrow"}],"updated":1793274810734,"created":1791533127601,"link":null,"locked":false},{"id":"QRKWGxq111tnpKIir1KDT","type":"text","x":-1055.8126221579514,"y":-728.3424662785254,"width":91.18977388139852,"height":85.69124954503104,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3t4V","roundness":null,"seed":35257646,"version":27,"versionNonce":53801979,"isDeleted":false,"boundElements":[],"updated":1793274751830,"created":1791533129185,"link":null,"locked":false,"text":"Der Anstieg des Meeresspiegels erfolgt\ndurch das Abschmelzen der Eismassen\nauf der Erde.\n\nDie meisten Eismassen auf unserer Erde\nbefinden sich entweder schwimmend auf\ndem Meer (den sogenannten Eisschollen)\noder in Gletschern (gro\u00dfe Eismassen, die\nvon den Bergen langsam in Richtung Tal\nstr\u00f6men).\n\nWelchen Einfluss beide Eismassen auf\nden Meeresspiegel haben, werdet ihr im\nn\u00e4chsten Experiment untersuchen.","fontSize":4.89664283114463,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"ailSy3b2lBw3tXHKFv28A","originalText":"Der Anstieg des Meeresspiegels erfolgt durch das Abschmelzen der Eismassen auf der Erde.\n\nDie meisten Eismassen auf unserer Erde befinden sich entweder schwimmend auf dem Meer (den sogenannten Eisschollen) oder in Gletschern (gro\u00dfe Eismassen, die von den Bergen langsam in Richtung Tal str\u00f6men).\n\nWelchen Einfluss beide Eismassen auf den Meeresspiegel haben, werdet ihr im n\u00e4chsten Experiment untersuchen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"04TUyUr9DA5J5af-X3vF0","type":"rectangle","x":-1362.6807159982297,"y":-868.7641494859382,"width":251.75495471708845,"height":133,"angle":0,"strokeColor":"transparent","backgroundColor":"#a1c6fa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3t5","roundness":null,"seed":1554220850,"version":210,"versionNonce":1345801429,"isDeleted":false,"boundElements":[{"type":"text","id":"qrjGO4syL--05leiC9mKX"},{"id":"ipFKgsyeeopGwIqr7imJ5","type":"arrow"},{"id":"qJu4yrxWErzx7Xg7-aYbr","type":"arrow"},{"id":"5qeaCgOGUgdtUpz3MBgrB","type":"arrow"}],"updated":1793275150149,"created":1791533140533,"link":null,"locked":false},{"id":"qrjGO4syL--05leiC9mKX","type":"text","x":-1357.6807159982297,"y":-863.4957972361025,"width":241.6999969482422,"height":122.46329550032847,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3t6","roundness":null,"seed":1496106798,"version":115,"versionNonce":1006722901,"isDeleted":false,"boundElements":[],"updated":1793274932087,"created":1791533147920,"link":null,"locked":false,"text":"Experiment A: Gletscher- und Eisschollenschmelze\n\nAufbau (siehe Bild rechts) und Anleitung:\n1.) Schaltet beide Heizplatten ein.\n2.) F\u00fcllt das Becherglas mit dem Stein bis zur 100 ml Markierung mit Wasser.\n3.) Legt zwei Eisw\u00fcrfel auf den Stein und stellt das Becherglas auf eine Heizplatte.\n4.) Bef\u00fcllt nun das zweite Becherglas mit zwei Eisw\u00fcrfeln und gie\u00dft Wasser hinzu bis\ngenau zur 100 ml Markierung.\n5.) Stellt auch dieses Becherglas auf eine Heizplatte.\n6.) \u00dcberlegt, welche Eismasse mit jedem Becherglas modellhaft dargestellt wird und\nordnet ihnen den Begriff Eisscholle oder Gletscher zu.\n7.) Wenn das Eis im zweiten Becherglas vollst\u00e4ndig geschmolzen ist, schaltet beide\nHeizplatten aus.\n8.) Vergleicht die beiden Wasserst\u00e4nde jeweils mit dem anf\u00e4nglichen Wasserstand von\n100 ml. Dokumentiert eure Ergebnisse im Projektheft.\n9.) Holt eine betreuende Person, um beim Entleeren der Gef\u00e4\u00dfe zu helfen.","fontSize":6.1231647750164235,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"04TUyUr9DA5J5af-X3vF0","originalText":"Experiment A: Gletscher- und Eisschollenschmelze\n\nAufbau (siehe Bild rechts) und Anleitung:\n1.) Schaltet beide Heizplatten ein.\n2.) F\u00fcllt das Becherglas mit dem Stein bis zur 100 ml Markierung mit Wasser.\n3.) Legt zwei Eisw\u00fcrfel auf den Stein und stellt das Becherglas auf eine Heizplatte.\n4.) Bef\u00fcllt nun das zweite Becherglas mit zwei Eisw\u00fcrfeln und gie\u00dft Wasser hinzu bis genau zur 100 ml Markierung.\n5.) Stellt auch dieses Becherglas auf eine Heizplatte.\n6.) \u00dcberlegt, welche Eismasse mit jedem Becherglas modellhaft dargestellt wird und ordnet ihnen den Begriff Eisscholle oder Gletscher zu.\n7.) Wenn das Eis im zweiten Becherglas vollst\u00e4ndig geschmolzen ist, schaltet beide Heizplatten aus.\n8.) Vergleicht die beiden Wasserst\u00e4nde jeweils mit dem anf\u00e4nglichen Wasserstand von 100 ml. Dokumentiert eure Ergebnisse im Projektheft.\n9.) Holt eine betreuende Person, um beim Entleeren der Gef\u00e4\u00dfe zu helfen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"Z0BRZ0SiTHYCDn5owlxva","type":"rectangle","x":-1433.9935651916094,"y":-1545.3956934368125,"width":269.68859217978087,"height":99.05687854738014,"angle":0,"strokeColor":"transparent","backgroundColor":"#a1c6fa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tB","roundness":null,"seed":1607376686,"version":123,"versionNonce":1373747419,"isDeleted":false,"boundElements":[{"type":"text","id":"Nn_T5MKkYZb6XYwdtJGM1"},{"id":"TDVOZ0pHIlk5z2UM3iRLA","type":"arrow"},{"id":"4k9GuIc3-ndKk4QIqWYxL","type":"arrow"}],"updated":1793278073017,"created":1791533323590,"link":null,"locked":false},{"id":"Nn_T5MKkYZb6XYwdtJGM1","type":"text","x":-1426.1892700172464,"y":-1527.8736249605495,"width":254.0800018310547,"height":64.01274159485426,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tC","roundness":null,"seed":1209487726,"version":67,"versionNonce":1447773461,"isDeleted":false,"boundElements":[],"updated":1793278073018,"created":1791533324832,"link":null,"locked":false,"text":"Schmilzt also Eis an der Arktis, so steigt dadurch der Meeresspiegel nicht an.\nSchmilzt es an der Antarktis, wo Landmassen unter dem Eisschild verborgen\nsind, so steigt er an.\n\nWarum die Abnahme von Eisfl\u00e4chen immer einen negativen Einfluss auf den\nTreibhauseffekt hat, erfahrt ihr in Mission 3.\n","fontSize":7.315741896554774,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"Z0BRZ0SiTHYCDn5owlxva","originalText":"Schmilzt also Eis an der Arktis, so steigt dadurch der Meeresspiegel nicht an. Schmilzt es an der Antarktis, wo Landmassen unter dem Eisschild verborgen sind, so steigt er an.\n\nWarum die Abnahme von Eisfl\u00e4chen immer einen negativen Einfluss auf den Treibhauseffekt hat, erfahrt ihr in Mission 3.\n","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"HtzP4_qfFYhRDiSxHlGMQ","type":"rectangle","x":-847.4782181858667,"y":-1183.1223555021963,"width":126.5671590067223,"height":126.5671590067223,"angle":0,"strokeColor":"transparent","backgroundColor":"#a1c6fa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tE","roundness":null,"seed":805206510,"version":81,"versionNonce":367105557,"isDeleted":false,"boundElements":[{"type":"text","id":"0xjdl8EAzD-hkJxZEB18m"},{"id":"mqDD-7NDg0io-sV9kZy81","type":"arrow"},{"id":"S-Z1wKyjWowGe12uhkKBF","type":"arrow"}],"updated":1793275765895,"created":1791533364567,"link":null,"locked":false},{"id":"0xjdl8EAzD-hkJxZEB18m","type":"text","x":-841.4046377669782,"y":-1170.0615611838336,"width":114.41999816894531,"height":100.44557036999682,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tEV","roundness":null,"seed":110964210,"version":33,"versionNonce":861530389,"isDeleted":false,"boundElements":[],"updated":1793275736449,"created":1791533365615,"link":null,"locked":false,"text":"Im Video konntet ihr schon einige\ngeografische Folgen kennenlernen.\n\nIn Abbildung 4 k\u00f6nnt ihr eine Karte von\nEuropa sehen. In dieser sind die neuen\nMeeresfl\u00e4chen eingezeichnet, wenn alles\nEis auf der Erde schmelzen w\u00fcrden, denn\ndabei w\u00fcrde der Meeresspiegel um 66m\nansteigen.\n\nBeschreibt die Fl\u00e4chenver\u00e4nderung f\u00fcr\nDeutschland (hell hervorgehoben) und\nVenedig (Venice) f\u00fcr diesen Fall.","fontSize":6.181265868922881,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"HtzP4_qfFYhRDiSxHlGMQ","originalText":"Im Video konntet ihr schon einige geografische Folgen kennenlernen.\n\nIn Abbildung 4 k\u00f6nnt ihr eine Karte von Europa sehen. In dieser sind die neuen Meeresfl\u00e4chen eingezeichnet, wenn alles Eis auf der Erde schmelzen w\u00fcrden, denn dabei w\u00fcrde der Meeresspiegel um 66m ansteigen.\n\nBeschreibt die Fl\u00e4chenver\u00e4nderung f\u00fcr Deutschland (hell hervorgehoben) und Venedig (Venice) f\u00fcr diesen Fall.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"VwDlfdDE6RsbgMnU2Zyfk","type":"rectangle","x":-389.66514212945833,"y":-796.6672805410858,"width":152.278407649514,"height":127.4915393074437,"angle":0,"strokeColor":"transparent","backgroundColor":"#a1c6fa","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tGV","roundness":null,"seed":1632397874,"version":96,"versionNonce":1238320789,"isDeleted":false,"boundElements":[{"type":"text","id":"sL8YOaqUomjBododhXowQ"},{"id":"gQnQQtjwEwFMz6mN9-hpl","type":"arrow"},{"id":"kYSswRpuYwxrMe0l4VwKA","type":"arrow"}],"updated":1793275798911,"created":1791533391908,"link":null,"locked":false},{"id":"sL8YOaqUomjBododhXowQ","type":"text","x":-382.0385360857076,"y":-778.8681728961263,"width":137.02519556201256,"height":91.89332401752473,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tH","roundness":null,"seed":454862578,"version":57,"versionNonce":1907600373,"isDeleted":false,"boundElements":[],"updated":1793275798912,"created":1791533392757,"link":null,"locked":false,"text":"Ihr habt viel \u00fcber die Folgen des\nMeeresspiegelanstieges erfahren.\n\nAufgabe 4\nPositioniert euch nun zu der Aussage von\nBen am Anfang. Geht dabei auf die\nVer\u00e4nderungen f\u00fcr euch pers\u00f6nlich und\nandere Menschen in Deutschland und\nEuropa ein.\nNotiert eure Gedanken im Projektheft.","fontSize":7.351465921401978,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"VwDlfdDE6RsbgMnU2Zyfk","originalText":"Ihr habt viel \u00fcber die Folgen des Meeresspiegelanstieges erfahren.\n\nAufgabe 4\nPositioniert euch nun zu der Aussage von Ben am Anfang. Geht dabei auf die Ver\u00e4nderungen f\u00fcr euch pers\u00f6nlich und andere Menschen in Deutschland und Europa ein.\nNotiert eure Gedanken im Projektheft.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"Sl7D73U_R64hhp0vdUeCV","type":"rectangle","x":-309.6255911578519,"y":-1275.4106474599678,"width":301.6916368641281,"height":145.9494796804093,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tHV","roundness":null,"seed":1302146414,"version":1020,"versionNonce":975075295,"isDeleted":false,"boundElements":[{"type":"text","id":"z0G3VTeXRtFeHYak3x68Q"},{"id":"lyxLEAro2STTKD7SCMOe_","type":"arrow"},{"id":"sSwHDnPDrhBxrNwDxqiiN","type":"arrow"}],"updated":1794301372822,"created":1791533555879,"link":null,"locked":false},{"id":"z0G3VTeXRtFeHYak3x68Q","type":"text","x":-299.27977272578755,"y":-1260.5657609736882,"width":281,"height":116.25970670784993,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tI","roundness":null,"seed":1829080114,"version":656,"versionNonce":2019697663,"isDeleted":false,"boundElements":[],"updated":1794301372822,"created":1791533558318,"link":null,"locked":false,"text":"Durch die globale Erw\u00e4rmung steigt die durchschnittliche\nTemperatur auf der Erde.  Im Eis sind 2,5 % des gesamten\nWassers der Erde gespeichert. Die globale Erw\u00e4rmung l\u00e4sst\ndiese Eismassen schmelzen.\n\nDie globale Eisschmelze l\u00e4sst den Meeresspiegel steigen.\n\nDie Erh\u00f6hung der Temperatur durch die Erderw\u00e4rmung hat\naber noch eine weitere Auswirkung.","fontSize":10.334196151808882,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"Sl7D73U_R64hhp0vdUeCV","originalText":"Durch die globale Erw\u00e4rmung steigt die durchschnittliche Temperatur auf der Erde.  Im Eis sind 2,5 % des gesamten Wassers der Erde gespeichert. Die globale Erw\u00e4rmung l\u00e4sst diese Eismassen schmelzen.\n\nDie globale Eisschmelze l\u00e4sst den Meeresspiegel steigen.\n\nDie Erh\u00f6hung der Temperatur durch die Erderw\u00e4rmung hat aber noch eine weitere Auswirkung.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"UhZXp1FWMtNuee-Wxj41W","type":"rectangle","x":-393.7926697889561,"y":-1447.1172406647795,"width":158.82714556116395,"height":91.98390341516487,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tIV","roundness":null,"seed":1076768750,"version":872,"versionNonce":619376021,"isDeleted":false,"boundElements":[{"type":"text","id":"1-KhkhF_WkqD7rgAlqSVn"},{"id":"sSwHDnPDrhBxrNwDxqiiN","type":"arrow"},{"id":"O8E-E3mbb8WMtNlu1l9K4","type":"arrow"}],"updated":1793274622349,"created":1791533576168,"link":null,"locked":false},{"id":"1-KhkhF_WkqD7rgAlqSVn","type":"text","x":-384.5165939566159,"y":-1432.2723541784999,"width":140.27499389648438,"height":62.29413044260552,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tJ","roundness":null,"seed":747774574,"version":556,"versionNonce":1629065887,"isDeleted":false,"boundElements":[],"updated":1793207366907,"created":1791533581204,"link":null,"locked":false,"text":"Pr\u00fcft die Temperatur des\nWassers und gebt bitte\nBescheid, falls sie gr\u00f6\u00dfer\nals 30 \u00b0C ist.","fontSize":12.458826088521104,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"UhZXp1FWMtNuee-Wxj41W","originalText":"Pr\u00fcft die Temperatur des Wassers und gebt bitte Bescheid, falls sie gr\u00f6\u00dfer als 30 \u00b0C ist.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"6vDooMGBPxJlm90L1q2ux","type":"rectangle","x":-455.74636593097966,"y":-1660.9678509825012,"width":376.6175213102097,"height":142.3294307093818,"angle":0.0012068657840700325,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tK","roundness":null,"seed":641702962,"version":1064,"versionNonce":632562235,"isDeleted":false,"boundElements":[{"type":"text","id":"NHiJp3WnouHinVBF50QGM"},{"id":"O8E-E3mbb8WMtNlu1l9K4","type":"arrow"},{"id":"7-tw3ApOKtLFa7NsteefC","type":"arrow"},{"id":"CwLr7GEanQc4GPVfRhtjr","type":"arrow"}],"updated":1793274622349,"created":1791533589566,"link":null,"locked":false},{"id":"NHiJp3WnouHinVBF50QGM","type":"text","x":-450.7463612090978,"y":-1646.130789526892,"width":353.6499938964844,"height":112.63965773682244,"angle":0.0012068657840700325,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tKV","roundness":null,"seed":1547747758,"version":783,"versionNonce":88043497,"isDeleted":false,"boundElements":[],"updated":1793207366907,"created":1791533590308,"link":null,"locked":false,"text":"Experiment B:\u00a0Temperatur und Wasser\n\n1.) Markiert den Wasserpegel mit dem Stift und stellt den Erlenmeyerkolben auf die\nHeizplatte und schaltet diese an (siehe Abb. rechts).\n2.) Beobachtet die \u00c4nderung des Wasserpegels in Abh\u00e4ngigkeit von der Temperatur.\n3.) Stoppt das Experiment sp\u00e4testens, wenn ihr bei 35 \u00b0C angekommen seid.\n4.) Stellt den Kolben in das Beh\u00e4ltnis mit dem kalten Wasser und wartet ca. 1 min, was\nk\u00f6nnt ihr beobachten? Notiert eure Beobachtung im Projektheft.\n5.) Entfernt die Markierungen, aber lasst den Kolben im kalten Wasser stehen!\n6.) Formuliert eine Schlussfolgerung eures Experimentes im Projektheft.","fontSize":9.011172618945796,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"6vDooMGBPxJlm90L1q2ux","originalText":"Experiment B:\u00a0Temperatur und Wasser\n\n1.) Markiert den Wasserpegel mit dem Stift und stellt den Erlenmeyerkolben auf die Heizplatte und schaltet diese an (siehe Abb. rechts).\n2.) Beobachtet die \u00c4nderung des Wasserpegels in Abh\u00e4ngigkeit von der Temperatur.\n3.) Stoppt das Experiment sp\u00e4testens, wenn ihr bei 35 \u00b0C angekommen seid.\n4.) Stellt den Kolben in das Beh\u00e4ltnis mit dem kalten Wasser und wartet ca. 1 min, was k\u00f6nnt ihr beobachten? Notiert eure Beobachtung im Projektheft.\n5.) Entfernt die Markierungen, aber lasst den Kolben im kalten Wasser stehen!\n6.) Formuliert eine Schlussfolgerung eures Experimentes im Projektheft.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"wrFYSHqErBEmvlCykANgM","type":"rectangle","x":-423.4859330602769,"y":-1787.8517374661324,"width":170.70350684095285,"height":60.15014361153313,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tL","roundness":null,"seed":1720493106,"version":693,"versionNonce":1332059701,"isDeleted":false,"boundElements":[{"type":"text","id":"BX-zio6TGUsqFl_QwjfiD"},{"id":"CwLr7GEanQc4GPVfRhtjr","type":"arrow"},{"id":"GsbAV2HzP1eEygpepK3QH","type":"arrow"}],"updated":1793274627587,"created":1791533607877,"link":null,"locked":false},{"id":"BX-zio6TGUsqFl_QwjfiD","type":"text","x":-414.87168269155814,"y":-1773.0068509798527,"width":153.47500610351562,"height":30.46037063897378,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tM","roundness":null,"seed":1147831790,"version":531,"versionNonce":232656789,"isDeleted":false,"boundElements":[],"updated":1793274627587,"created":1791533608792,"link":null,"locked":false,"text":"Bitte helft den nachfolgenden Gruppen,\nindem ihr das Wasser im Abk\u00fchlbeh\u00e4ltnis\naustauscht.","fontSize":8.122765503726342,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"wrFYSHqErBEmvlCykANgM","originalText":"Bitte helft den nachfolgenden Gruppen, indem ihr das Wasser im Abk\u00fchlbeh\u00e4ltnis austauscht.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"eZdI1lONH4mvvRHXbfo4p","type":"rectangle","x":17.75981262476671,"y":-1993.5494283528203,"width":223.0809756541751,"height":139.00492153374867,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tS","roundness":null,"seed":1198031854,"version":1583,"versionNonce":641879125,"isDeleted":false,"boundElements":[{"type":"text","id":"Gr70JhcDvI726nsjaAVbJ"},{"id":"ezbqUv8UOljsL6dKskuo5","type":"arrow"},{"id":"ex5gmDD6fIbgZej-g1kRa","type":"arrow"}],"updated":1793274622349,"created":1791533697595,"link":null,"locked":false},{"id":"Gr70JhcDvI726nsjaAVbJ","type":"text","x":25.825301977733034,"y":-1978.7045418665405,"width":206.9499969482422,"height":109.3151485611893,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tSV","roundness":null,"seed":1575920942,"version":950,"versionNonce":24770501,"isDeleted":false,"boundElements":[],"updated":1793207366907,"created":1791533698850,"link":null,"locked":false,"text":"Aufgabe 2:\n\nWas passiert, wenn die Temperaturen auf\nunserer Erde steigen?\n\nBeantwortet die Frage im Projektheft,\nindem ihr die richtigen Antworten\nankreuzt.","fontSize":10.93151485611893,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"eZdI1lONH4mvvRHXbfo4p","originalText":"Aufgabe 2:\n\nWas passiert, wenn die Temperaturen auf unserer Erde steigen?\n\nBeantwortet die Frage im Projektheft, indem ihr die richtigen Antworten ankreuzt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"L-8cdD69zPuuBwp2yZVLD","type":"rectangle","x":68.30444186248315,"y":-1809.1617924976715,"width":269.55470571605485,"height":126.41311993441957,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tT","roundness":null,"seed":1250454190,"version":756,"versionNonce":253169531,"isDeleted":false,"boundElements":[{"id":"DnY0UNE9bGPyn5k-gW7-q","type":"text"},{"id":"ex5gmDD6fIbgZej-g1kRa","type":"arrow"},{"id":"K7Oif1qtADSH_nEbYbEfv","type":"arrow"}],"updated":1793274622349,"created":1791533706440,"link":null,"locked":false},{"id":"DnY0UNE9bGPyn5k-gW7-q","type":"text","x":77.89429472051052,"y":-1789.4807386632988,"width":250.375,"height":87.05101226567419,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tU","roundness":null,"seed":597403506,"version":587,"versionNonce":1795029354,"isDeleted":false,"boundElements":[],"updated":1793207366907,"created":1791533707461,"link":null,"locked":false,"text":"Am 06.07.2020 stellte die AfD-Fraktion eine Anfrage an die\nBundesregierung  bez\u00fcglich des Anstieges des Meeresspiegels.\n\nDie AfD behauptete, dass der Meeresspiegel in den letzten 100 Jahren\nlinear angestiegen sei und weiterhin gleichstark ansteigen w\u00fcrde.\nKlimaschutz sei also zu teuer, da der Meeresspiegelanstieg von 31 cm in\nden n\u00e4chsten 100 Jahren f\u00fcr Deutschland uninteressant w\u00e4re.\n\nAber stimmt das? Bertrachtet zun\u00e4chst die folgende Abbildung 6.","fontSize":7.737867756948816,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"L-8cdD69zPuuBwp2yZVLD","originalText":"Am 06.07.2020 stellte die AfD-Fraktion eine Anfrage an die Bundesregierung  bez\u00fcglich des Anstieges des Meeresspiegels.\n\nDie AfD behauptete, dass der Meeresspiegel in den letzten 100 Jahren linear angestiegen sei und weiterhin gleichstark ansteigen w\u00fcrde. Klimaschutz sei also zu teuer, da der Meeresspiegelanstieg von 31 cm in den n\u00e4chsten 100 Jahren f\u00fcr Deutschland uninteressant w\u00e4re.\n\nAber stimmt das? Bertrachtet zun\u00e4chst die folgende Abbildung 6.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"yXmaOVkMdB5FEE2gLbpWy","type":"rectangle","x":35.48557934029668,"y":-1469.7927716372594,"width":213.01232566029216,"height":107.01055023244157,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tV","roundness":null,"seed":226023026,"version":814,"versionNonce":1564473781,"isDeleted":false,"boundElements":[{"type":"text","id":"SBop3G3-xBjn2kRTFYNUS"},{"id":"jbUVuxrc3JU6ozG-DbyeS","type":"arrow"},{"id":"1KA5BxYGWydSOd0Op1syM","type":"arrow"}],"updated":1793274622349,"created":1791533746277,"link":null,"locked":false},{"id":"SBop3G3-xBjn2kRTFYNUS","type":"text","x":43.9292421704431,"y":-1450.6522864143196,"width":196.125,"height":68.72957978656197,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tVV","roundness":null,"seed":210561842,"version":673,"versionNonce":391589963,"isDeleted":false,"boundElements":[],"updated":1793207366907,"created":1791533747098,"link":null,"locked":false,"text":"Aufgabe 3:\nBeantwortet mit Hilfe des Diagrammes die folgenden Fragen in\neurem Projektheft:\na)\u00a0Um wie viel ist der Meeresspiegel in den letzten 100 Jahren\n(ca. 1900 bis 2000) ungef\u00e4hr angestiegen?\nb) Um wie viel ist der Meeresspiegel in einem der letzten\nJahrzehnte (1990 bis 2000) ungef\u00e4hr angestiegen?\nc)\u00a0Welche Aussage zum Anstieg des Meeresspiegels stimmt?\u00a0","fontSize":6.872957978656197,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"yXmaOVkMdB5FEE2gLbpWy","originalText":"Aufgabe 3:\nBeantwortet mit Hilfe des Diagrammes die folgenden Fragen in eurem Projektheft:\na)\u00a0Um wie viel ist der Meeresspiegel in den letzten 100 Jahren (ca. 1900 bis 2000) ungef\u00e4hr angestiegen?\nb) Um wie viel ist der Meeresspiegel in einem der letzten Jahrzehnte (1990 bis 2000) ungef\u00e4hr angestiegen?\nc)\u00a0Welche Aussage zum Anstieg des Meeresspiegels stimmt?\u00a0","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"m-o_fqx9-C1FNkG4Z_EXb","type":"rectangle","x":53.30947369700516,"y":-1199.285821639029,"width":231.80855113690285,"height":126.70488030555852,"angle":0,"strokeColor":"transparent","backgroundColor":"#80e5dc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tW","roundness":null,"seed":293559666,"version":876,"versionNonce":303917083,"isDeleted":false,"boundElements":[{"type":"text","id":"fCNzQwJL6L0U7cAEW1b22"},{"id":"1KA5BxYGWydSOd0Op1syM","type":"arrow"},{"id":"GiMgq--9ZrCVoJmF4o0Ew","type":"arrow"},{"id":"INr67DWRh-z1WLFkYBOJI","type":"arrow"}],"updated":1793274622349,"created":1791533761253,"link":null,"locked":false},{"id":"fCNzQwJL6L0U7cAEW1b22","type":"text","x":61.97624621369869,"y":-1176.9732391663047,"width":214.47500610351562,"height":82.07971536010945,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tWV","roundness":null,"seed":68548590,"version":656,"versionNonce":329996491,"isDeleted":false,"boundElements":[],"updated":1793207366907,"created":1791533762968,"link":null,"locked":false,"text":"In dieser Station hast du einen Effekt kennengelernt, der\nneben der Eisschmelze auch f\u00fcr den Meeresspiegelanstieg\nverantwortlich ist. Forschende sind sich dabei nicht ganz\nsicher, wie gro\u00df der Einfluss der W\u00e4rmeausdehnung\nwirklich ist. Die Berechnung, die der Abbildung 7 (oben)\nzugrunde liegt, bemisst der\u00a0W\u00e4rmeausdehnung einen\nEinfluss von circa 50% f\u00fcr den Meeresspiegelanstieg\nzwischen den Jahren 2005 bis 2020.","fontSize":8.207971536010945,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"m-o_fqx9-C1FNkG4Z_EXb","originalText":"In dieser Station hast du einen Effekt kennengelernt, der neben der Eisschmelze auch f\u00fcr den Meeresspiegelanstieg verantwortlich ist. Forschende sind sich dabei nicht ganz sicher, wie gro\u00df der Einfluss der W\u00e4rmeausdehnung wirklich ist. Die Berechnung, die der Abbildung 7 (oben) zugrunde liegt, bemisst der\u00a0W\u00e4rmeausdehnung einen Einfluss von circa 50% f\u00fcr den Meeresspiegelanstieg zwischen den Jahren 2005 bis 2020.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"uHPzeGcFpZfb9BUcQe3qM","type":"rectangle","x":93.85644723857962,"y":-629.0624523801278,"width":140.8620062636463,"height":99.77648029068952,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tY","roundness":null,"seed":1115618098,"version":310,"versionNonce":698347195,"isDeleted":false,"boundElements":[{"type":"text","id":"0yJeliTrR6mtSF9CEjEHH"},{"id":"8H1dnwrnFtsrzJMaJDYk7","type":"arrow"},{"id":"mUqw4CiGIpDaLHsb4I8LK","type":"arrow"}],"updated":1793277974829,"created":1791534002550,"link":null,"locked":false},{"id":"0yJeliTrR6mtSF9CEjEHH","type":"text","x":99.29745250663325,"y":-603.3703585513114,"width":129.97999572753906,"height":48.39229263305665,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tZ","roundness":null,"seed":1506458802,"version":267,"versionNonce":1944172661,"isDeleted":false,"boundElements":[],"updated":1793277972567,"created":1791534004249,"link":null,"locked":false,"text":"Euer Nachbar pflanzt in seinem Garten keine Pflanzen, da er\nbehauptet, dass Gr\u00fcnfl\u00e4chen die globale Erderw\u00e4rmung\nf\u00f6rdern w\u00fcrden. Stattdessen legt er einen Steingarten mit\ngrauem und wei\u00dfem Kiesel an. Er meint, das w\u00fcrde besser\ngegen Licht und Hitze sch\u00fctzen.\n\nAber sind Pflanzen nicht eigentlich gut f\u00fcr das Klima?\nIn dieser Mission untersucht ihr die Meinung des Nachbarn.","fontSize":4.839229263305665,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"uHPzeGcFpZfb9BUcQe3qM","originalText":"Euer Nachbar pflanzt in seinem Garten keine Pflanzen, da er behauptet, dass Gr\u00fcnfl\u00e4chen die globale Erderw\u00e4rmung f\u00f6rdern w\u00fcrden. Stattdessen legt er einen Steingarten mit grauem und wei\u00dfem Kiesel an. Er meint, das w\u00fcrde besser gegen Licht und Hitze sch\u00fctzen.\n\nAber sind Pflanzen nicht eigentlich gut f\u00fcr das Klima?\nIn dieser Mission untersucht ihr die Meinung des Nachbarn.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"0Tsd5cy3ROvK02lZDQjB3","type":"rectangle","x":212.13323760157766,"y":-765.9160656049822,"width":109.16876275429543,"height":109.16876275429543,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tZV","roundness":null,"seed":1622159022,"version":47,"versionNonce":454918331,"isDeleted":false,"boundElements":[{"type":"text","id":"8FdzACrx3hsc2sQ_Orc4r"},{"id":"BjFHZ4TkGvduAe6B7G7rF","type":"arrow"}],"updated":1793276872474,"created":1791534030912,"link":null,"locked":false},{"id":"8FdzACrx3hsc2sQ_Orc4r","type":"text","x":218.82293740310007,"y":-742.5673449408365,"width":95.78936315125057,"height":62.471321426003875,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ta","roundness":null,"seed":1030458606,"version":15,"versionNonce":1071786293,"isDeleted":false,"boundElements":[],"updated":1793276847604,"created":1791534031709,"link":null,"locked":false,"text":"Die Sonne kann W\u00e4rme in\nForm von Strahlung abgeben.\nWenn euch diese\nW\u00e4rmestrahlen treffen, k\u00f6nnt\nihr sie absorbieren, daher\nf\u00fchlt ihr die \u201eW\u00e4rme\u201c der\nSonne.","fontSize":7.1395795915433,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"0Tsd5cy3ROvK02lZDQjB3","originalText":"Die Sonne kann W\u00e4rme in Form von Strahlung abgeben. Wenn euch diese W\u00e4rmestrahlen treffen, k\u00f6nnt ihr sie absorbieren, daher f\u00fchlt ihr die \u201eW\u00e4rme\u201c der Sonne.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"8x_NtLOLxzvHDk4dP6LJN","type":"rectangle","x":383.44663144008643,"y":-970.0025117511145,"width":89.1435766111849,"height":89.1435766111849,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tb","roundness":null,"seed":1185186414,"version":81,"versionNonce":1979681045,"isDeleted":false,"boundElements":[{"type":"text","id":"yNS96EBWqAEs5LCv0UNqq"},{"id":"BjFHZ4TkGvduAe6B7G7rF","type":"arrow"},{"id":"4gX_3pDt5z2yq66xhEefb","type":"arrow"}],"updated":1793276983946,"created":1791534040084,"link":null,"locked":false},{"id":"yNS96EBWqAEs5LCv0UNqq","type":"text","x":389.5922299910866,"y":-948.8645029416138,"width":76.85237950918456,"height":46.86755899218339,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tbV","roundness":null,"seed":1539724526,"version":30,"versionNonce":15194517,"isDeleted":false,"boundElements":[],"updated":1793276869227,"created":1791534041034,"link":null,"locked":false,"text":"Die Umgebung erw\u00e4rmt\nsich also, wenn die\nSonnenstrahlen von\nOberfl\u00e4chen absorbiert\nwerden. Dies f\u00f6rdert aber\ndie globale Erderw\u00e4rmung.","fontSize":6.249007865624452,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"8x_NtLOLxzvHDk4dP6LJN","originalText":"Die Umgebung erw\u00e4rmt sich also, wenn die Sonnenstrahlen von Oberfl\u00e4chen absorbiert werden. Dies f\u00f6rdert aber die globale Erderw\u00e4rmung.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"q4P0Ocic-POI-98e6gXOg","type":"rectangle","x":576.8144121810788,"y":-851.3594303864555,"width":99.8500760739058,"height":99.8500760739058,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3teV","roundness":null,"seed":1465252082,"version":89,"versionNonce":2031967867,"isDeleted":false,"boundElements":[{"type":"text","id":"luiWYa4yZQIcYLEF8HOcH"},{"id":"arcRz43fpaVxlnF-unXPS","type":"arrow"},{"id":"Mbefbsc3E14yi6P3JWzYt","type":"arrow"}],"updated":1793277037236,"created":1791534084037,"link":null,"locked":false},{"id":"luiWYa4yZQIcYLEF8HOcH","type":"text","x":583.5724568230587,"y":-837.9503691096808,"width":86.33398678994597,"height":73.03195352035625,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tf","roundness":null,"seed":1107912370,"version":54,"versionNonce":1674830613,"isDeleted":false,"boundElements":[],"updated":1793277016611,"created":1791534084739,"link":null,"locked":false,"text":"Auf dem Bild konntet ihr die\nReflexion und Absorption der\nSonnenstrahlen an einer\nOberfl\u00e4che sehen.\n\n Reale Oberfl\u00e4chen werden\naber das Sonnenlicht sowohl\nabsorbieren als auch\nreflektieren.","fontSize":6.491729201809445,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"q4P0Ocic-POI-98e6gXOg","originalText":"Auf dem Bild konntet ihr die Reflexion und Absorption der Sonnenstrahlen an einer Oberfl\u00e4che sehen.\n\n Reale Oberfl\u00e4chen werden aber das Sonnenlicht sowohl absorbieren als auch reflektieren.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"cCg4AGi1P55eM46tmpXrq","type":"rectangle","x":748.2037074596676,"y":-905.2554437455967,"width":105.02027642147443,"height":67.702675296819,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tfV","roundness":null,"seed":1101871410,"version":184,"versionNonce":430090581,"isDeleted":false,"boundElements":[{"type":"text","id":"uiUShc7VckcF5FfguI-GH"},{"id":"Mbefbsc3E14yi6P3JWzYt","type":"arrow"},{"id":"uatpLYoowi-estNZITu2Q","type":"arrow"}],"updated":1793277054284,"created":1791534093380,"link":null,"locked":false},{"id":"uiUShc7VckcF5FfguI-GH","type":"text","x":753.0759187957574,"y":-890.9670994499936,"width":95.27585374929494,"height":39.12598670561278,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tg","roundness":null,"seed":1854784306,"version":94,"versionNonce":586912181,"isDeleted":false,"boundElements":[],"updated":1793277029082,"created":1791534094324,"link":null,"locked":false,"text":"Dieser Effekt ist von Fl\u00e4che zu Fl\u00e4che unterschiedlich.\n\nDer Albedo-Wert gibt Auskunft dar\u00fcber, wie gro\u00df der\nAnteil der Sonnenstrahlung ist, den eine Oberfl\u00e4che\nzur\u00fcckwirft (reflektiert).\nWenn 40% des Lichts zur\u00fcckgeworfen werden, dann\nhat ein K\u00f6rper einen Albedo-Wert von 0,4. Der Wert\nist \u00fcblicherweise zwischen 0 und 1 (0 % und 100 %).","fontSize":3.912598670561278,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"cCg4AGi1P55eM46tmpXrq","originalText":"Dieser Effekt ist von Fl\u00e4che zu Fl\u00e4che unterschiedlich.\n\nDer Albedo-Wert gibt Auskunft dar\u00fcber, wie gro\u00df der Anteil der Sonnenstrahlung ist, den eine Oberfl\u00e4che zur\u00fcckwirft (reflektiert).\nWenn 40% des Lichts zur\u00fcckgeworfen werden, dann hat ein K\u00f6rper einen Albedo-Wert von 0,4. Der Wert ist \u00fcblicherweise zwischen 0 und 1 (0 % und 100 %).","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"4YwADs41u-HE6OKIbW5X3","type":"rectangle","x":841.1344735999246,"y":-1072.8112104989764,"width":84.08518248002454,"height":84.08518248002454,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3th","roundness":null,"seed":100335410,"version":104,"versionNonce":1743313851,"isDeleted":false,"boundElements":[{"type":"text","id":"Azk1uM4EME8ZUgbj7AjQY"},{"id":"2ntoguFrwoY8BqSG6B8KO","type":"arrow"}],"updated":1793277074531,"created":1791534115532,"link":null,"locked":false},{"id":"Azk1uM4EME8ZUgbj7AjQY","type":"text","x":849.0095664535129,"y":-1041.1203152694304,"width":68.3349967728479,"height":20.703392020932554,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3thV","roundness":null,"seed":1664261742,"version":61,"versionNonce":1637251931,"isDeleted":false,"boundElements":[],"updated":1793277052619,"created":1791534116373,"link":null,"locked":false,"text":"Wie kann der Albedo-Wert\neines K\u00f6rpers bestimmt\nwerden?","fontSize":5.520904538915348,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"4YwADs41u-HE6OKIbW5X3","originalText":"Wie kann der Albedo-Wert eines K\u00f6rpers bestimmt werden?","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"vm6NXrmB7kVEcq5UgXCHj","type":"rectangle","x":776.9891105717528,"y":-1316.8398249318582,"width":111.1779646658057,"height":111.1779646658057,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ti","roundness":null,"seed":546546094,"version":83,"versionNonce":851840411,"isDeleted":false,"boundElements":[{"type":"text","id":"c4J0y0ZSqhDk-u2BebxB5"},{"id":"UCK_c1OlvVZA2HiHIFMAZ","type":"arrow"}],"updated":1793277086911,"created":1791534132624,"link":null,"locked":false},{"id":"c4J0y0ZSqhDk-u2BebxB5","type":"text","x":783.9156931029414,"y":-1298.6503079958875,"width":97.32479960342842,"height":74.7989307938641,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tj","roundness":null,"seed":1519091826,"version":38,"versionNonce":2081214101,"isDeleted":false,"boundElements":[],"updated":1793277073131,"created":1791534133473,"link":null,"locked":false,"text":" In der Wissenschaft gibt es\ndaf\u00fcr die physikalische Gr\u00f6\u00dfe\nder Beleuchtungsst\u00e4rke. Sie gibt\nan, mit welcher Intensit\u00e4t eine\nFl\u00e4che beleuchtet wird.\n\n Die Beleuchtungsst\u00e4rke wird in\nLux angegeben und mit einem\nLuxmeter gemessen.","fontSize":6.648793848343476,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"vm6NXrmB7kVEcq5UgXCHj","originalText":" In der Wissenschaft gibt es daf\u00fcr die physikalische Gr\u00f6\u00dfe der Beleuchtungsst\u00e4rke. Sie gibt an, mit welcher Intensit\u00e4t eine Fl\u00e4che beleuchtet wird.\n\n Die Beleuchtungsst\u00e4rke wird in Lux angegeben und mit einem Luxmeter gemessen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"YqcCLGzMDF0r5A6CPLCqU","type":"rectangle","x":915.5178927531459,"y":-1478.1016487338322,"width":82.24871520322431,"height":82.24871520322431,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tjV","roundness":null,"seed":1908474610,"version":92,"versionNonce":93961397,"isDeleted":false,"boundElements":[{"type":"text","id":"vlRjaEOzAYh56l7UDG8P2"},{"id":"UCK_c1OlvVZA2HiHIFMAZ","type":"arrow"},{"id":"LBetwCdGkaynn42sXO3vS","type":"arrow"}],"updated":1793277663440,"created":1791534150331,"link":null,"locked":false},{"id":"vlRjaEOzAYh56l7UDG8P2","type":"text","x":921.6322520332249,"y":-1453.5901322534446,"width":70.0199966430664,"height":33.22568224244884,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tk","roundness":null,"seed":2079556402,"version":47,"versionNonce":1984580123,"isDeleted":false,"boundElements":[],"updated":1793277663442,"created":1791534151189,"link":null,"locked":false,"text":"Untersucht im folgenden\nExperiment, welche\nLandschaften gut die\nSonnenstrahlung reflektieren\nk\u00f6nnen.","fontSize":5.316109158791815,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"YqcCLGzMDF0r5A6CPLCqU","originalText":"Untersucht im folgenden Experiment, welche Landschaften gut die Sonnenstrahlung reflektieren k\u00f6nnen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"qSNzkqdkDIxCjddfC5hs8","type":"rectangle","x":1121.8753719674169,"y":-1389.5354856289507,"width":197.63632990017697,"height":123.47734681306014,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tl","roundness":null,"seed":2037904818,"version":453,"versionNonce":333487963,"isDeleted":false,"boundElements":[{"type":"text","id":"trb-D1jyCKOwHdw4fntRN"},{"id":"LBetwCdGkaynn42sXO3vS","type":"arrow"},{"id":"z6O3pVQmQLQLAeOxPiJeH","type":"arrow"},{"id":"8qo-uqGEeK5mMWcSnEV7Q","type":"arrow"}],"updated":1793277685304,"created":1791534161903,"link":null,"locked":false},{"id":"trb-D1jyCKOwHdw4fntRN","type":"text","x":1126.8753719674169,"y":-1371.2030144964822,"width":182.75999450683594,"height":86.81240454812303,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tlV","roundness":null,"seed":39826286,"version":330,"versionNonce":1656464309,"isDeleted":false,"boundElements":[],"updated":1793277667077,"created":1791534162669,"link":null,"locked":false,"text":"Experiment C: Untersuchung von Albedo-Werten\n\nAnleitung:\n1.) Vorsicht, die Lampe ist schon eingeschaltet, sie ist hei\u00df.\n2.) Schaltet die Luxmeter ein (Automatische Abschaltung nach 5 Min.). Eines der\nLuxmeter misst die einstrahlende Beleuchtung. Notiert euch den Wert und achtet\nbei allen Messungen darauf, dass dieser Wert \u00e4hnlich bleibt.\n3.) Stellt nun eine Landschaft (Karton) unter die Lampe und notiert die reflektierte\nBeleuchtungsst\u00e4rke im Projektheft.\n4.) Tauscht danach die Landschaften aus ohne die Lampe oder die Luxmeter zu\nverschieben, bis ihr f\u00fcr alle einen Wert aufgenommen habt.\n\nAchtung: Die Landschaft mit dem Gebirge enth\u00e4lt zwei zu messende Zust\u00e4nde\n(Gebirge: mit und ohne Schnee).","fontSize":4.960708831321315,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"qSNzkqdkDIxCjddfC5hs8","originalText":"Experiment C: Untersuchung von Albedo-Werten\n\nAnleitung:\n1.) Vorsicht, die Lampe ist schon eingeschaltet, sie ist hei\u00df.\n2.) Schaltet die Luxmeter ein (Automatische Abschaltung nach 5 Min.). Eines der Luxmeter misst die einstrahlende Beleuchtung. Notiert euch den Wert und achtet bei allen Messungen darauf, dass dieser Wert \u00e4hnlich bleibt.\n3.) Stellt nun eine Landschaft (Karton) unter die Lampe und notiert die reflektierte Beleuchtungsst\u00e4rke im Projektheft.\n4.) Tauscht danach die Landschaften aus ohne die Lampe oder die Luxmeter zu verschieben, bis ihr f\u00fcr alle einen Wert aufgenommen habt.\n\nAchtung: Die Landschaft mit dem Gebirge enth\u00e4lt zwei zu messende Zust\u00e4nde (Gebirge: mit und ohne Schnee).","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"YxXWs4wTep7OWxZxOyJfV","type":"rectangle","x":1454.4773921529952,"y":-1467.1675324823773,"width":104.88120736106409,"height":104.88120736106409,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tn","roundness":null,"seed":1296525422,"version":178,"versionNonce":519039451,"isDeleted":false,"boundElements":[{"type":"text","id":"MEft9qBdS8toPs-DXVYka"},{"id":"8qo-uqGEeK5mMWcSnEV7Q","type":"arrow"},{"id":"ftKLq5Ek_F0QY4bRTqgW5","type":"arrow"}],"updated":1793277712234,"created":1791534191864,"link":null,"locked":false},{"id":"MEft9qBdS8toPs-DXVYka","type":"text","x":1463.2434992728167,"y":-1457.1367043459763,"width":87.34899312142106,"height":84.81955108826233,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tnV","roundness":null,"seed":2115913646,"version":137,"versionNonce":1251086581,"isDeleted":false,"boundElements":[],"updated":1793277683682,"created":1791534192670,"link":null,"locked":false,"text":"Je gr\u00f6\u00dfer die reflektierte\nBeleuchtungsst\u00e4rke ist, desto gr\u00f6\u00dfer ist\nder Albedo-Wert.\n\n\nAufgabe 1:\nSortiert in eurem Projektheft die\nLandschaften nach steigendem Albedo-\nWert.\n\n(Hinweis:\u00a0Die realen Albedo-Werte der\nLandschaften sind zu diesen Modell-\nMessungen verschieden und lassen sich\nnicht daraus berechnen.)","fontSize":4.846831490757847,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"YxXWs4wTep7OWxZxOyJfV","originalText":"Je gr\u00f6\u00dfer die reflektierte Beleuchtungsst\u00e4rke ist, desto gr\u00f6\u00dfer ist der Albedo-Wert.\n\n\nAufgabe 1:\nSortiert in eurem Projektheft die Landschaften nach steigendem Albedo-Wert.\n\n(Hinweis:\u00a0Die realen Albedo-Werte der Landschaften sind zu diesen Modell-Messungen verschieden und lassen sich nicht daraus berechnen.)","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"v4_Oa4dQdyp-nSDpWVili","type":"rectangle","x":1421.1479119726355,"y":-1218.3561673304102,"width":91.16510861277924,"height":75.99859505540081,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tpV","roundness":null,"seed":1774067374,"version":92,"versionNonce":750205659,"isDeleted":false,"boundElements":[{"type":"text","id":"YxD6hRU36kTkE4sySk3W4"},{"id":"c_sdeMsTQ2Pe6RgGP4rpy","type":"arrow"}],"updated":1793277796030,"created":1791534242634,"link":null,"locked":false},{"id":"YxD6hRU36kTkE4sySk3W4","type":"text","x":1427.7471326913785,"y":-1207.3469025410423,"width":77.96666717529297,"height":53.98006547666482,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tq","roundness":null,"seed":970559730,"version":183,"versionNonce":1631085745,"isDeleted":false,"boundElements":[],"updated":1794389923662,"created":1791534243551,"link":null,"locked":false,"text":"Aufgabe 2:\nVergleicht au\u00dferdem das Aussehen der\nLandschaften und stellt eine Vermutung\nauf, wovon der Albedo-Wert abh\u00e4ngig\nsein k\u00f6nnte und vervollst\u00e4ndigt den\nL\u00fcckentext, der sich \u00f6ffnet, wenn ihr auf\ndiese Karte tippt.\n\n\u00dcbertragt die L\u00fccken ins Projektheft,\nwenn alles richtig ist.","fontSize":4.318405238133185,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"v4_Oa4dQdyp-nSDpWVili","originalText":"Aufgabe 2:\nVergleicht au\u00dferdem das Aussehen der Landschaften und stellt eine Vermutung auf, wovon der Albedo-Wert abh\u00e4ngig sein k\u00f6nnte und vervollst\u00e4ndigt den L\u00fcckentext, der sich \u00f6ffnet, wenn ihr auf diese Karte tippt.\n\n\u00dcbertragt die L\u00fccken ins Projektheft, wenn alles richtig ist.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"rGocHSQLCgwdE26eFb5OH","type":"rectangle","x":1276.8315109336418,"y":-1132.499595644064,"width":100.18458809318874,"height":100.18458809318874,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tr","roundness":null,"seed":1729026802,"version":63,"versionNonce":947125365,"isDeleted":false,"boundElements":[{"type":"text","id":"UfGKa3mir2XaGdY4NE2kA"},{"id":"OwtJtzepj6-OFS3TycttO","type":"arrow"}],"updated":1793277815139,"created":1791534258170,"link":null,"locked":false},{"id":"UfGKa3mir2XaGdY4NE2kA","type":"text","x":1284.5105994226471,"y":-1122.8521898105892,"width":84.82641111517819,"height":80.88977642623904,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3trV","roundness":null,"seed":777891314,"version":27,"versionNonce":971029877,"isDeleted":false,"boundElements":[],"updated":1793277793645,"created":1791534258873,"link":null,"locked":false,"text":"Wir halten also fest: Helle\nFl\u00e4chen haben einen hohen\nAlbedo-Wert. Sie heizen sich\nweniger stark auf.\n\nDunklere Fl\u00e4chen wie gr\u00fcne\nW\u00e4lder oder Parks haben\neinen geringeren Albedo-\nWert als helle Fl\u00e4chen wie\nKiesg\u00e4rten.","fontSize":6.471182114099124,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"rGocHSQLCgwdE26eFb5OH","originalText":"Wir halten also fest: Helle Fl\u00e4chen haben einen hohen Albedo-Wert. Sie heizen sich weniger stark auf.\n\nDunklere Fl\u00e4chen wie gr\u00fcne W\u00e4lder oder Parks haben einen geringeren Albedo-Wert als helle Fl\u00e4chen wie Kiesg\u00e4rten.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"p_b_INrrQHLSvY1zW_VEV","type":"rectangle","x":1077.9242566668709,"y":-998.3371176775714,"width":148.90797329466048,"height":88.12920655533682,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ts","roundness":null,"seed":213684978,"version":163,"versionNonce":217455989,"isDeleted":false,"boundElements":[{"type":"text","id":"jQ16PLDoQbRP-_MSWTe3g"},{"id":"lcPj8wW85Qc_wBDI52SZl","type":"arrow"}],"updated":1793278122825,"created":1791534270814,"link":null,"locked":false},{"id":"jQ16PLDoQbRP-_MSWTe3g","type":"text","x":1083.6282433142012,"y":-988.9100259132335,"width":137.5,"height":69.27502302666095,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tt","roundness":null,"seed":363783474,"version":178,"versionNonce":185606828,"isDeleted":false,"boundElements":[],"updated":1794411487170,"created":1791534271550,"link":null,"locked":false,"text":"Hat euer Nachbar also damit recht gehabt, dass Pflanzen auf\nGrund ihres geringen Albedo-Wertes die Erderw\u00e4rmung\nbest\u00e4rken?\n\nBetrachtet die nachfolgende Karten von Groitzsch. \n\nVergleicht das Satellitenbild mit der W\u00e4rmebildaufnahme.\nUntersucht insbesondere dunklere Fl\u00e4chen wie z.B. Wald\nPfarrholz westlich von eurer Schule\n\nWo ist es k\u00fchler, wo ist es besonders warm?","fontSize":5.038183492848069,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"p_b_INrrQHLSvY1zW_VEV","originalText":"Hat euer Nachbar also damit recht gehabt, dass Pflanzen auf Grund ihres geringen Albedo-Wertes die Erderw\u00e4rmung best\u00e4rken?\n\nBetrachtet die nachfolgende Karten von Groitzsch. \n\nVergleicht das Satellitenbild mit der W\u00e4rmebildaufnahme. Untersucht insbesondere dunklere Fl\u00e4chen wie z.B. Wald Pfarrholz westlich von eurer Schule\n\nWo ist es k\u00fchler, wo ist es besonders warm?","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"81k8V_T0Kc4RqCgX3paCe","type":"rectangle","x":975.148494665148,"y":-841.190931928799,"width":364.0205506596019,"height":136.88546583208938,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ttV","roundness":null,"seed":1341228146,"version":185,"versionNonce":805166740,"isDeleted":false,"boundElements":[{"type":"text","id":"0nZYWQV-uI1NdpalKWVwJ"},{"id":"wvz26QE3IobJwKhQBKmwq","type":"arrow"}],"updated":1794411679168,"created":1791534291451,"link":null,"locked":false},{"id":"0nZYWQV-uI1NdpalKWVwJ","type":"text","x":1014.9587730467067,"y":-715.8609451249565,"width":284.3999938964844,"height":6.55547902824691,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tu","roundness":null,"seed":1550992046,"version":269,"versionNonce":278818964,"isDeleted":false,"boundElements":[],"updated":1794411648471,"created":1791534292658,"link":null,"locked":false,"text":"Abbildung 9: Satellitenaufnahme von Groitzsch (links), Karte per Satellit gemessener Oberfl\u00e4chentemperaturen (rechts)","fontSize":5.244383222597528,"fontFamily":6,"textAlign":"center","verticalAlign":"bottom","containerId":"81k8V_T0Kc4RqCgX3paCe","originalText":"Abbildung 9: Satellitenaufnahme von Groitzsch (links), Karte per Satellit gemessener Oberfl\u00e4chentemperaturen (rechts)","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"DEZP_V1j1F9825Hu6wWTi","type":"rectangle","x":744.4493896457901,"y":-753.6147674543676,"width":134.82675568502583,"height":89.99642769569337,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tv","roundness":null,"seed":1998730414,"version":193,"versionNonce":646832027,"isDeleted":false,"boundElements":[{"type":"text","id":"VK4y6u8x3EOF-a4dhRfnP"},{"id":"wvz26QE3IobJwKhQBKmwq","type":"arrow"},{"id":"4eesOnKWUXQhAKX5R9tid","type":"arrow"}],"updated":1793278008813,"created":1791534308039,"link":null,"locked":false},{"id":"VK4y6u8x3EOF-a4dhRfnP","type":"text","x":749.2402040690723,"y":-746.1956601223969,"width":125.24512683846147,"height":75.15821303175217,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tvV","roundness":null,"seed":895537902,"version":126,"versionNonce":243610683,"isDeleted":false,"boundElements":[],"updated":1793278008813,"created":1791534308874,"link":null,"locked":false,"text":"Obwohl der Albedo-Wert von Gr\u00fcnfl\u00e4chen geringer ist,\nhaben die bepflanzten Gebiete eine geringere\nTemperatur als die Betonw\u00fcsten\n\nDas liegt am stark k\u00fchlenden Effekt der Pflanzen!.\n\nAn den Bl\u00e4ttern der Pflanzen verdunstet Wasser\n(Transpiration). Damit das Wasser in den gasf\u00f6rmigen\nAggregatszustand \u00fcbergehen kann, ben\u00f6tigt es\nEnergie. Diese Energie wird in Form von W\u00e4rme aus\nder Umgebung entzogen. Die Umgebung k\u00fchlt sich ab,\nweil dieser Effekt st\u00e4rker ist, als der Albedo-Effekt.","fontSize":5.0105475354501445,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"DEZP_V1j1F9825Hu6wWTi","originalText":"Obwohl der Albedo-Wert von Gr\u00fcnfl\u00e4chen geringer ist, haben die bepflanzten Gebiete eine geringere Temperatur als die Betonw\u00fcsten\n\nDas liegt am stark k\u00fchlenden Effekt der Pflanzen!.\n\nAn den Bl\u00e4ttern der Pflanzen verdunstet Wasser (Transpiration). Damit das Wasser in den gasf\u00f6rmigen Aggregatszustand \u00fcbergehen kann, ben\u00f6tigt es Energie. Diese Energie wird in Form von W\u00e4rme aus der Umgebung entzogen. Die Umgebung k\u00fchlt sich ab, weil dieser Effekt st\u00e4rker ist, als der Albedo-Effekt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"tNJs4XbcTwFi5h-6RyFZp","type":"rectangle","x":608.8864808345065,"y":-623.9834499353382,"width":108.3179063252974,"height":66.89034959366575,"angle":0,"strokeColor":"transparent","backgroundColor":"#fda8b2","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tw","roundness":null,"seed":1312913966,"version":346,"versionNonce":2065917589,"isDeleted":false,"boundElements":[{"type":"text","id":"vkRcaIy3omY-FFe7xzb3D"},{"id":"4eesOnKWUXQhAKX5R9tid","type":"arrow"},{"id":"UcjZUVfmlx3MLwxDF7E0x","type":"arrow"}],"updated":1793278003919,"created":1791534320531,"link":null,"locked":false},{"id":"vkRcaIy3omY-FFe7xzb3D","type":"text","x":616.4060414199961,"y":-611.477841562282,"width":93.27878515431836,"height":41.879132847553535,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3tx","roundness":null,"seed":1990612722,"version":180,"versionNonce":595839989,"isDeleted":false,"boundElements":[],"updated":1793278003919,"created":1791534321503,"link":null,"locked":false,"text":"Nun wisst ihr, wovon die\nOberfl\u00e4chentemperatur\nabh\u00e4ngig ist. Nutzt euer\ntheoretisches Wissen jetzt, um\nes in der Realit\u00e4t anzuwenden.","fontSize":6.700661255608566,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"tNJs4XbcTwFi5h-6RyFZp","originalText":"Nun wisst ihr, wovon die Oberfl\u00e4chentemperatur abh\u00e4ngig ist. Nutzt euer theoretisches Wissen jetzt, um es in der Realit\u00e4t anzuwenden.","aut