er.","fontSize":6.723916968649631,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"6I3HNFtWtIGWF1b1BqBX1","originalText":"\nNeben der Absorption gibt es auch die Reflexion. Bei der Reflexion werden die Sonnenstrahlen wieder zurückgeworfen. Insgesamt wird damit nur ein Teil der Strahlung absorbiert. Daher erwärmen sich Oberflächen, welche gut reflektieren können, auch weniger.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"rV1BPRpAPhe9fqe4OTr_2","type":"image","x":543.3883951571598,"y":-1092.6586225428384,"width":184.9764800183934,"height":100.83787278780474,"angle":0,"strokeColor":"transparent","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["5LbfxZ_BimXsf163iWGPT","YefOMLwO-GPGd4F5kluOL"],"frameId":null,"index":"b7i","roundness":null,"seed":1912150523,"version":376,"versionNonce":185961429,"isDeleted":false,"boundElements":[],"updated":1793278114785,"created":1793276650886,"link":null,"locked":false,"status":"saved","fileId":"1fc3ff2ede985d0e642340442b6610c8e9b8339b","scale":[1,1],"crop":null},{"id":"GjeekZVAxi6I0-mmrui-P","type":"text","x":544.9042737374496,"y":-979.4758916914825,"width":182.80464042121173,"height":6.059216482458725,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#fdc89d","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":["Rp38WWbH780ddQtX5MUOV","zduCPHsvVAyeKOM5Vq4vP","X9AVvC8l8jRcMHRAgAkNe","POSU20DAZEhAKMRkMDlXd","5LbfxZ_BimXsf163iWGPT","YefOMLwO-GPGd4F5kluOL"],"frameId":null,"index":"b7iV","roundness":null,"seed":1661508405,"version":1759,"versionNonce":53645617,"isDeleted":false,"boundElements":[],"updated":1794399936926,"created":1793276683167,"link":null,"locked":false,"text":"\nQuelle: CC-BY Christian Siegel (Abbildung erstellt mithilfe KI [Anthropic, Sonnet 5.5])","fontSize":2.42368659298349,"baseFontSize":null,"fontFamily":8,"textAlign":"left",