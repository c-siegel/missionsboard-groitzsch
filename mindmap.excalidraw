fDmuk5DAyq7kS9F7WRqEo","type":"arrow"}],"updated":1794389631310,"created":1791534425124,"link":null,"locked":false},{"id":"Zi-WKuMfIWmx6MFkVfMR7","type":"text","x":418.23279359815695,"y":-316.62068557530307,"width":162.60000610351562,"height":96.1280897808943,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3u","roundness":null,"seed":1999156270,"version":143,"versionNonce":1168574847,"isDeleted":false,"boundElements":[],"updated":1794389561146,"created":1791534543844,"link":null,"locked":false,"text":"Marie meint: \"Ich habe in den\nNachrichten geh\u00f6rt, dass der\nTreibhauseffekt unsere Erde\nzerst\u00f6ren wird. W\u00fcrde es den nicht\ngeben, w\u00e4re unsere Erde gerettet!\"\n\nPeter erwidert: \"Aber ohne ihn w\u00fcrde\nes uns Menschen gar nicht geben!\"","fontSize":9.61280897808943,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"CRlMQ0rvq0yMJqLi1JFak","originalText":"Marie meint: \"Ich habe in den Nachrichten geh\u00f6rt, dass der Treibhauseffekt unsere Erde zerst\u00f6ren wird. W\u00fcrde es den nicht geben, w\u00e4re unsere Erde gerettet!\"\n\nPeter erwidert: \"Aber ohne ihn w\u00fcrde es uns Menschen gar nicht geben!\"","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"RvS4lqne4t8ITov6dXNqj","type":"rectangle","x":695.526775587316,"y":-401.67120156494866,"width":174.30766934961312,"height":174.30766934961312,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3u1","roundness":null,"seed":202779122,"version":210,"versionNonce":1043328273,"isDeleted":false,"boundElements":[{"type":"text","id":"YWDLO7YPOnjoFuti8lFJK"},{"id":"B7wh5q8KfVwNKjU7lUPJK","type":"arrow"},{"id":"fDmuk5DAyq7kS9F7WRqEo","type":"arrow"}],"updated":1794389635658,"created":1791534555666,"link":null,"locked":false},{"id":"YWDLO7YPOnjoFuti8lFJK","type":"text","x":704.2606120931773,"y":-378.5819719137255,"width":156.83999633789062,"height":128.12921004716685,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3u2","roundness":null,"seed":1757904114,"version":174,"versionNonce":1675061951,"isDeleted":false,"boundElements":[],"updated":1794389620220,"created":1791534556709,"link":null,"locked":false,"text":"Wer von beiden hat wohl recht?\n\nUntersucht zuerst Maries Aussage,\nindem ihr herausfindet, welche\nWirkung der Treibhauseffekt\n\u00fcberhaupt hat.\n\nIm folgenden Modellexperiment l\u00e4sst\nsich der Effekt gut veranschaulichen,\nauch wenn er nicht direkt die\nWirklichkeit abbildet.","fontSize":9.318488003430316,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"RvS4lqne4t8ITov6dXNqj","originalText":"Wer von beiden hat wohl recht?\n\nUntersucht zuerst Maries Aussage, indem ihr herausfindet, welche Wirkung der Treibhauseffekt \u00fcberhaupt hat.\n\nIm folgenden Modellexperiment l\u00e4sst sich der Effekt gut veranschaulichen, auch wenn er nicht direkt die Wirklichkeit abbildet.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"4aRTdo2OhjjtbwZ-W7sNC","type":"rectangle","x":1014.640272544166,"y":-411.4434361389156,"width":276.50121324734977,"height":154.42451011288765,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3u3","roundness":null,"seed":1324719986,"version":337,"versionNonce":1656819985,"isDeleted":false,"boundElements":[{"type":"text","id":"Hmcikm8sWy6sOyCxn5qGV"},{"id":"B7wh5q8KfVwNKjU7lUPJK","type":"arrow"},{"id":"IkxZa6D5Wx_5mZ05B2OQk","type":"arrow"},{"id":"zSXLg6yjoubtKvGCwEUk7","type":"arrow"}],"updated":1794389878379,"created":1791534564417,"link":null,"locked":false},{"id":"Hmcikm8sWy6sOyCxn5qGV","type":"text","x":1019.640272544166,"y":-398.5747269628416,"width":262.3833312988281,"height":128.68709176073972,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3u4","roundness":null,"seed":1747413362,"version":231,"versionNonce":175252127,"isDeleted":false,"boundElements":[],"updated":1794389831144,"created":1791534565459,"link":null,"locked":false,"text":"Experiment D: Modellatmosph\u00e4re\n\nAnleitung:\n1.) Stellt sicher, dass beide Thermometer angeschlossen sind und die\nMessf\u00fchler etwa gleich weit aus den \"Erden\" nach oben ragen.\n2.) Deckt die \u201eErde\u201c, welche an T1 angeschlossen ist, mit der Modell-\nAtmosph\u00e4re (Halbkugel) ab.\n3.) Schaltet die Lampe an und achtet darauf, dass beide \u201eErden\u201c mittig\nunter der Lampe liegen (siehe Abbildung 10).\n4.) Beobachtet die beiden Temperaturen.\n5.) Schaltet die Lampe aus.\n6.) Beschreibt im Projektheft, welche Gemeinsamkeiten und Unterschiede\nihr beobachten konntet.","fontSize":7.919205646814753,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"4aRTdo2OhjjtbwZ-W7sNC","originalText":"Experiment D: Modellatmosph\u00e4re\n\nAnleitung:\n1.) Stellt sicher, dass beide Thermometer angeschlossen sind und die Messf\u00fchler etwa gleich weit aus den \"Erden\" nach oben ragen.\n2.) Deckt die \u201eErde\u201c, welche an T1 angeschlossen ist, mit der Modell-Atmosph\u00e4re (Halbkugel) ab.\n3.) Schaltet die Lampe an und achtet darauf, dass beide \u201eErden\u201c mittig unter der Lampe liegen (siehe Abbildung 10).\n4.) Beobachtet die beiden Temperaturen.\n5.) Schaltet die Lampe aus.\n6.) Beschreibt im Projektheft, welche Gemeinsamkeiten und Unterschiede ihr beobachten konntet.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"7v7vyMSs5jg8YeI4eQoq4","type":"rectangle","x":1829.2513926619856,"y":-10.848744066173538,"width":189.58857607208336,"height":117.95291066853235,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uA","roundness":null,"seed":1987582002,"version":244,"versionNonce":378865983,"isDeleted":false,"boundElements":[{"type":"text","id":"9i003sfe5doog6PXRmzYB"},{"id":"QHXDEozIriRyHPiXonreG","type":"arrow"},{"id":"u5WWjhIsOXhB4mR8hwdb2","type":"arrow"}],"updated":1794400052394,"created":1791534615501,"link":null,"locked":false},{"id":"9i003sfe5doog6PXRmzYB","type":"text","x":1835.0790135227344,"y":-1.153930540925444,"width":177.93333435058594,"height":98.56328361803617,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uC","roundness":null,"seed":1614275630,"version":201,"versionNonce":2076940511,"isDeleted":false,"boundElements":[],"updated":1794390129009,"created":1791534616532,"link":null,"locked":false,"text":"Die Quelle der Erderw\u00e4rmung ist unsere Sonne.\nIhre W\u00e4rmestrahlung trifft mit einer Intensit\u00e4t von\n340 W/m\u00b2 auf die Erdoberfl\u00e4che. Ein bestimmter\nTeil der Sonnenstrahlung wird aber reflektiert\n(wie in Mission 3: Albedoeffekt gesehen).\n\nEffektiv treffen dadurch nur noch 70 % der\ngesamten Sonnenstrahlung auf die Erde. Wir\nerhalten daher nur noch 238 W/m\u00b2 an der\nOberfl\u00e4che.","fontSize":7.8850626894428935,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"7v7vyMSs5jg8YeI4eQoq4","originalText":"Die Quelle der Erderw\u00e4rmung ist unsere Sonne. Ihre W\u00e4rmestrahlung trifft mit einer Intensit\u00e4t von 340 W/m\u00b2 auf die Erdoberfl\u00e4che. Ein bestimmter Teil der Sonnenstrahlung wird aber reflektiert (wie in Mission 3: Albedoeffekt gesehen).\n\nEffektiv treffen dadurch nur noch 70 % der gesamten Sonnenstrahlung auf die Erde. Wir erhalten daher nur noch 238 W/m\u00b2 an der Oberfl\u00e4che.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"22Ohaolo2MHULfN5ag8Hr","type":"rectangle","x":1421.8915759155266,"y":22.786703923096297,"width":194.59531750355998,"height":123.62524943536965,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uG","roundness":null,"seed":1768324334,"version":364,"versionNonce":1307656241,"isDeleted":false,"boundElements":[{"type":"text","id":"Xt4MwO4Snq6-ErRL8_Acm"},{"id":"u5WWjhIsOXhB4mR8hwdb2","type":"arrow"},{"id":"zWwvfi8mv1pgdIoEVlWzL","type":"arrow"}],"updated":1794400239606,"created":1791534677647,"link":null,"locked":false},{"id":"Xt4MwO4Snq6-ErRL8_Acm","type":"text","x":1428.703165991271,"y":36.959411581490656,"width":180.9721373520712,"height":95.27983411858096,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uH","roundness":null,"seed":693657070,"version":158,"versionNonce":1948520657,"isDeleted":false,"boundElements":[],"updated":1794400051399,"created":1791534679152,"link":null,"locked":false,"text":"Welcher Zusammenhang besteht nun zwischen der\nW\u00e4rmestrahlung und der Temperatur eines K\u00f6rpers?\n\nDie aufgeheizte Erde strahlt bei einer bestimmten Temperatur\neine bestimmte Intensit\u00e4t an W\u00e4rmestrahlung ab. Dieser\nZusammenhang ist aber nicht linear und wird im Stefan-\nBoltzmann-Diagramm (Abbildung 12) dargestellt.\n\nJe h\u00f6her die Temperatur ist, desto gr\u00f6\u00dfer ist die abgestrahlte\nW\u00e4rme. Es bildet sich eine Gleichgewicht zwischen der von der\nSonne empfangenen und von der Erdoberfl\u00e4che abgestrahlten\nIntensit\u00e4t.","fontSize":6.351988941238731,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"22Ohaolo2MHULfN5ag8Hr","originalText":"Welcher Zusammenhang besteht nun zwischen der W\u00e4rmestrahlung und der Temperatur eines K\u00f6rpers?\n\nDie aufgeheizte Erde strahlt bei einer bestimmten Temperatur eine bestimmte Intensit\u00e4t an W\u00e4rmestrahlung ab. Dieser Zusammenhang ist aber nicht linear und wird im Stefan-Boltzmann-Diagramm (Abbildung 12) dargestellt.\n\nJe h\u00f6her die Temperatur ist, desto gr\u00f6\u00dfer ist die abgestrahlte W\u00e4rme. Es bildet sich eine Gleichgewicht zwischen der von der Sonne empfangenen und von der Erdoberfl\u00e4che abgestrahlten Intensit\u00e4t.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"CrlQhGmIxr218ZyULyFx6","type":"rectangle","x":819.8743707372887,"y":207.14449510714715,"width":154.3169661375781,"height":122.21669730197065,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uK","roundness":null,"seed":567009266,"version":169,"versionNonce":1584593425,"isDeleted":false,"boundElements":[{"type":"text","id":"ZepLaatTgvthTcy2ubE11"},{"id":"PK6BmoeV3t5OBviUH14Uz","type":"arrow"}],"updated":1794400284748,"created":1791534702109,"link":null,"locked":false},{"id":"ZepLaatTgvthTcy2ubE11","type":"text","x":828.9985166601505,"y":231.48304602470805,"width":136.0686742918548,"height":73.53959546684884,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uL","roundness":null,"seed":1037041262,"version":136,"versionNonce":884627697,"isDeleted":false,"boundElements":[],"updated":1794400267693,"created":1791534702830,"link":null,"locked":false,"text":"Ohne Atmosph\u00e4re w\u00fcrde die Erde also\neine Intensit\u00e4t von 238 W/m\u00b2 abstrahlen.\n\n2. Aufgabe:\nNutze das Diagramm, um die zugeh\u00f6rige\nTemperatur der Erdoberfl\u00e4che f\u00fcr diese\nIntensit\u00e4t abzulesen und trage den Wert\nins Projektheft ein.","fontSize":7.353959546684884,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"CrlQhGmIxr218ZyULyFx6","originalText":"Ohne Atmosph\u00e4re w\u00fcrde die Erde also eine Intensit\u00e4t von 238 W/m\u00b2 abstrahlen.\n\n2. Aufgabe:\nNutze das Diagramm, um die zugeh\u00f6rige Temperatur der Erdoberfl\u00e4che f\u00fcr diese Intensit\u00e4t abzulesen und trage den Wert ins Projektheft ein.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"A_hfwIJgsI68BH2PEs2N_","type":"rectangle","x":510.66766262940155,"y":151.84682387011708,"width":158.17233590276004,"height":166.2487236385138,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uM","roundness":null,"seed":1947013998,"version":165,"versionNonce":168896415,"isDeleted":false,"boundElements":[{"type":"text","id":"E30PZjANNXMDahV0f1QJ-"},{"id":"RbA1sn52J8BS66wdK7eJb","type":"arrow"}],"updated":1794400293269,"created":1791534722885,"link":null,"locked":false},{"id":"E30PZjANNXMDahV0f1QJ-","type":"text","x":519.5822721215355,"y":163.46635831797022,"width":140.3431169184921,"height":143.00965474280758,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uO","roundness":null,"seed":1216549550,"version":123,"versionNonce":1758156511,"isDeleted":false,"boundElements":[],"updated":1794400282337,"created":1791534723970,"link":null,"locked":false,"text":"Unsere Atmosph\u00e4re ist \u00fcberlebenswichtig\nf\u00fcr uns. Hatte Peter nun recht?\n\nJein. Denn schon durch eine sehr kleine\n\u00c4nderung der Zusammensetzung unserer\nAtmosph\u00e4re (z.B. durch mehr\nKohlenstoffdioxid) wird die Absorption und\ndamit R\u00fcckstrahlung zur Erde erh\u00f6ht.\nDadurch entsteht eine h\u00f6here Temperatur\nim Gleichgewicht, es kommt zur\nErderw\u00e4rmung.\n\nZum Beispiel kommt es bei einer erh\u00f6hten\nAbsorption von 85% (statt der vorher\nabgesch\u00e4tzten 80%) zu einer\nTemperaturerh\u00f6hung auf der Erde von 3\u00b0C !","fontSize":7.15048273714038,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"A_hfwIJgsI68BH2PEs2N_","originalText":"Unsere Atmosph\u00e4re ist \u00fcberlebenswichtig f\u00fcr uns. Hatte Peter nun recht?\n\nJein. Denn schon durch eine sehr kleine \u00c4nderung der Zusammensetzung unserer Atmosph\u00e4re (z.B. durch mehr Kohlenstoffdioxid) wird die Absorption und damit R\u00fcckstrahlung zur Erde erh\u00f6ht. Dadurch entsteht eine h\u00f6here Temperatur im Gleichgewicht, es kommt zur Erderw\u00e4rmung.\n\nZum Beispiel kommt es bei einer erh\u00f6hten Absorption von 85% (statt der vorher abgesch\u00e4tzten 80%) zu einer Temperaturerh\u00f6hung auf der Erde von 3\u00b0C !","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"PGwzZQO6cW4MBaz3akTnV","type":"rectangle","x":706.5229237433474,"y":-103.88197363557174,"width":147.30930850048057,"height":147.30930850048057,"angle":0,"strokeColor":"transparent","backgroundColor":"#bac2ff","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uP","roundness":null,"seed":851439346,"version":159,"versionNonce":990414431,"isDeleted":false,"boundElements":[{"type":"text","id":"xjRoy9IiB9oGlFjk7lTYP"},{"id":"oPkOUHFPsq7bbCDeaJubW","type":"arrow"}],"updated":1794400300073,"created":1791534783928,"link":null,"locked":false},{"id":"xjRoy9IiB9oGlFjk7lTYP","type":"text","x":714.3330655871295,"y":-92.06282718658207,"width":131.68902481291656,"height":123.67101560250121,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uQ","roundness":null,"seed":320510002,"version":123,"versionNonce":1846472145,"isDeleted":false,"boundElements":[],"updated":1794400280084,"created":1791534784873,"link":null,"locked":false,"text":"Ein zunehmender Treibhauseffekt\nder Atmosph\u00e4re erzeugt also die\nglobale Erw\u00e4rmung.\n\n Um das Aufheizen des Planeten zu\nstoppen, m\u00fcssen wir den\nTreibhauseffekt regulieren. Welche\nM\u00f6glichkeiten haben wir jedoch\ndaf\u00fcr?\n\nVielleicht wei\u00df eine andere Station\ndie L\u00f6sung!","fontSize":8.24473437350008,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"PGwzZQO6cW4MBaz3akTnV","originalText":"Ein zunehmender Treibhauseffekt der Atmosph\u00e4re erzeugt also die globale Erw\u00e4rmung.\n\n Um das Aufheizen des Planeten zu stoppen, m\u00fcssen wir den Treibhauseffekt regulieren. Welche M\u00f6glichkeiten haben wir jedoch daf\u00fcr?\n\nVielleicht wei\u00df eine andere Station die L\u00f6sung!","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"OdL0AH5vQIVMh0zPMCoVo","type":"rectangle","x":177.8845404725314,"y":437.741640047495,"width":147.14726552682936,"height":105.26517495334286,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uS","roundness":null,"seed":615672242,"version":200,"versionNonce":1317213873,"isDeleted":false,"boundElements":[{"type":"text","id":"mOm7R8mFw1bFHU312gUmH"},{"id":"yp7vUHiqi3_peEPLVrR_F","type":"arrow"},{"id":"8eLvIMq_N04WGx9UnqCVH","type":"arrow"},{"id":"_MXLND0qeuFiSTRR9RGvg","type":"arrow"}],"updated":1794400644640,"created":1791536944798,"link":null,"locked":false},{"id":"mOm7R8mFw1bFHU312gUmH","type":"text","x":185.33543358696306,"y":452.6397170226957,"width":132.24547929796603,"height":75.46902100294152,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uT","roundness":null,"seed":1065175474,"version":52,"versionNonce":1208747423,"isDeleted":false,"boundElements":[],"updated":1794400421011,"created":1791536982204,"link":null,"locked":false,"text":"Ihr entdeckt diese \u00dcberschrift eines Artikels\nonline, in dem das Absterben von Muscheln\nim Meer mit der Versauerung der Meere\nbegr\u00fcndet wird.\n\nUm diese Aussage zu \u00fcberpr\u00fcfen, sollt ihr\nim Folgenden experimentell die\nAuswirkung von sauren L\u00f6sungen auf\nMuscheln untersuchen","fontSize":6.70835742248369,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"OdL0AH5vQIVMh0zPMCoVo","originalText":"Ihr entdeckt diese \u00dcberschrift eines Artikels online, in dem das Absterben von Muscheln im Meer mit der Versauerung der Meere begr\u00fcndet wird.\n\nUm diese Aussage zu \u00fcberpr\u00fcfen, sollt ihr im Folgenden experimentell die Auswirkung von sauren L\u00f6sungen auf Muscheln untersuchen","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"lLughLkzzWwZzpvCfKjub","type":"rectangle","x":332.9739825284296,"y":636.9383314947613,"width":286.04019638552904,"height":78,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uU","roundness":null,"seed":731419378,"version":142,"versionNonce":1458911167,"isDeleted":false,"boundElements":[{"type":"text","id":"UCD9rtMABgnEmArLSAkps"},{"id":"_MXLND0qeuFiSTRR9RGvg","type":"arrow"},{"id":"Q83eQK8zDBFdvn4dRpV5X","type":"arrow"},{"id":"9S7RQD-V_PfSk53IOoTif","type":"arrow"}],"updated":1794400751632,"created":1791537026218,"link":null,"locked":false},{"id":"UCD9rtMABgnEmArLSAkps","type":"text","x":337.9739825284296,"y":641.9655606190111,"width":264.6166687011719,"height":67.94554175150061,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uV","roundness":null,"seed":380375410,"version":69,"versionNonce":906370033,"isDeleted":false,"boundElements":[],"updated":1794400652851,"created":1791537027057,"link":null,"locked":false,"text":"Experiment E: S\u00e4ure und Muscheln\n\nAnleitung:\n1.) F\u00fcllt in die Petrischale (flache Schale) eine Spatelspitze Zitronens\u00e4ure (in Pulverform).\n2.) Sch\u00fcttet nun wenige Milliliter Wasser in die Schale und verr\u00fchrt alles mit der Pipette.\n3.) Nutzt die Pipette, um etwas von der L\u00f6sung auf die wei\u00dfen Stellen der Muschel zu tropfen.\n4.) Beobachtet genau, was passiert. Vielleicht k\u00f6nnt Ihr auvh ein leises Ger\u00e4usch h\u00f6ren (Hinweis:\nSolltet ihr noch nichts beobachten k\u00f6nnen, erh\u00f6ht die Menge an Zitronens\u00e4ure in der L\u00f6sung)\n5.) R\u00e4umt anschlie\u00dfend den Platz auf und achtet darauf, dass alles trocken ist.","fontSize":6.039603711244499,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"lLughLkzzWwZzpvCfKjub","originalText":"Experiment E: S\u00e4ure und Muscheln\n\nAnleitung:\n1.) F\u00fcllt in die Petrischale (flache Schale) eine Spatelspitze Zitronens\u00e4ure (in Pulverform).\n2.) Sch\u00fcttet nun wenige Milliliter Wasser in die Schale und verr\u00fchrt alles mit der Pipette.\n3.) Nutzt die Pipette, um etwas von der L\u00f6sung auf die wei\u00dfen Stellen der Muschel zu tropfen.\n4.) Beobachtet genau, was passiert. Vielleicht k\u00f6nnt Ihr auvh ein leises Ger\u00e4usch h\u00f6ren (Hinweis: Solltet ihr noch nichts beobachten k\u00f6nnen, erh\u00f6ht die Menge an Zitronens\u00e4ure in der L\u00f6sung)\n5.) R\u00e4umt anschlie\u00dfend den Platz auf und achtet darauf, dass alles trocken ist.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"9TFMctrN981D4BQXkXslA","type":"rectangle","x":670.68664475769,"y":757.047383160141,"width":106.92331612062517,"height":66.82706286396028,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uW","roundness":null,"seed":1476452018,"version":130,"versionNonce":1483546271,"isDeleted":false,"boundElements":[{"type":"text","id":"wBou3Zb5k6ehlIZkkJTvz"},{"id":"9S7RQD-V_PfSk53IOoTif","type":"arrow"},{"id":"Xx6P_F0EXRew1vLJ8Ja1y","type":"arrow"}],"updated":1794400780189,"created":1791537039005,"link":null,"locked":false},{"id":"wBou3Zb5k6ehlIZkkJTvz","type":"text","x":689.7024273579975,"y":770.6035682004989,"width":68.89175092001011,"height":39.71469278324443,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uX","roundness":null,"seed":1322024430,"version":66,"versionNonce":31849041,"isDeleted":false,"boundElements":[],"updated":1794400750290,"created":1791537039788,"link":null,"locked":false,"text":"Aufgabe 1:\nSchreibt eure\nBeobachtungen ins\nProjektheft","fontSize":7.942938556648886,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"9TFMctrN981D4BQXkXslA","originalText":"Aufgabe 1:\nSchreibt eure Beobachtungen ins Projektheft","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"lWEMbtm15lmcVb01pKc00","type":"rectangle","x":979.9797602481759,"y":663.436581975842,"width":166.42005448337886,"height":109.87164459915196,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uY","roundness":null,"seed":1581118002,"version":128,"versionNonce":1121835935,"isDeleted":false,"boundElements":[{"type":"text","id":"YVBSsPpcdNsCZaYDYssg9"},{"id":"Xx6P_F0EXRew1vLJ8Ja1y","type":"arrow"},{"id":"5X9cuKfhYU5iBnaCLNhY2","type":"arrow"}],"updated":1794400823281,"created":1791537074717,"link":null,"locked":false},{"id":"YVBSsPpcdNsCZaYDYssg9","type":"text","x":990.1715620912346,"y":674.0965745437549,"width":146.0364507972614,"height":88.55165946332626,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uZ","roundness":null,"seed":662503150,"version":52,"versionNonce":1663153503,"isDeleted":false,"boundElements":[],"updated":1794400770290,"created":1791537075503,"link":null,"locked":false,"text":"Der Grund f\u00fcr eure Beobachtungen ist eine\nchemische Reaktion.\u00a0\n\nDabei reagiert der Kalk in den Muscheln stark mit\nder sauren L\u00f6sung, die ihr aus Zitronens\u00e4ure und\nWasser hergestellt hattet.\n\nBei dieser Reaktion entsteht unter anderem\ngasf\u00f6rmiges Kohlenstoffdioxid (Formel: CO2), was\ndie Gasentwicklung w\u00e4hrend des Experimentes\nerkl\u00e4rt.","fontSize":6.44012068824191,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"lWEMbtm15lmcVb01pKc00","originalText":"Der Grund f\u00fcr eure Beobachtungen ist eine chemische Reaktion.\u00a0\n\nDabei reagiert der Kalk in den Muscheln stark mit der sauren L\u00f6sung, die ihr aus Zitronens\u00e4ure und Wasser hergestellt hattet.\n\nBei dieser Reaktion entsteht unter anderem gasf\u00f6rmiges Kohlenstoffdioxid (Formel: CO2), was die Gasentwicklung w\u00e4hrend des Experimentes erkl\u00e4rt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"MktaMl-7VMcmY2G52dBgG","type":"rectangle","x":1167.428623681344,"y":813.0662590623339,"width":243.595850564672,"height":100,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ua","roundness":null,"seed":1556489582,"version":398,"versionNonce":1741156391,"isDeleted":false,"boundElements":[{"type":"text","id":"oPYn7XL3pK3kGFMELW8yB"},{"id":"hHpvwCjEk6iuAwd7gE_Ct","type":"arrow"}],"updated":1794407040419,"created":1791537093996,"link":null,"locked":false},{"id":"oPYn7XL3pK3kGFMELW8yB","type":"text","x":1181.8182161389732,"y":818.1905524905044,"width":214.81666564941406,"height":89.75141314365902,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ub","roundness":null,"seed":1723497074,"version":267,"versionNonce":1495030385,"isDeleted":false,"boundElements":[],"updated":1794400820272,"created":1791537094981,"link":null,"locked":false,"text":"Es kann vermutet werden, dass Kalk auch mit\nanderen sauren L\u00f6sungen reagiert.\n\nUm zu untersuchen, ob eine L\u00f6sung sauer ist,\nkann der pH-Wert gemessen werden. Der pH-\nWert erm\u00f6glicht die Unterscheidung zwischen\nsauren, neutralen und basischen L\u00f6sungen.","fontSize":10.257304359275317,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"MktaMl-7VMcmY2G52dBgG","originalText":"Es kann vermutet werden, dass Kalk auch mit anderen sauren L\u00f6sungen reagiert.\n\nUm zu untersuchen, ob eine L\u00f6sung sauer ist, kann der pH-Wert gemessen werden. Der pH-Wert erm\u00f6glicht die Unterscheidung zwischen sauren, neutralen und basischen L\u00f6sungen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"ywZpaqnesJ-cL7kElOa81","type":"rectangle","x":1009.4027141652946,"y":1100.1532537564408,"width":116.14446587228602,"height":95.43256033817863,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uf","roundness":null,"seed":1312021486,"version":223,"versionNonce":498092647,"isDeleted":false,"boundElements":[{"type":"text","id":"m2uDngfsLmi3pw4UN5Oin"},{"id":"oPpCnJxp5Hz8f92zHDTOP","type":"arrow"},{"id":"6bzTnU9k9LI4_1AMTwwsQ","type":"arrow"}],"updated":1794407078836,"created":1791537151721,"link":null,"locked":false},{"id":"m2uDngfsLmi3pw4UN5Oin","type":"text","x":1015.6449452703829,"y":1116.358782870471,"width":103.66000366210938,"height":63.021502110117964,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uh","roundness":null,"seed":942146098,"version":158,"versionNonce":1907740233,"isDeleted":false,"boundElements":[],"updated":1794407065636,"created":1791537152596,"link":null,"locked":false,"text":"Ihr wisst jetzt, dass die\nMuscheln empfindlich\ngegen\u00fcber sauren L\u00f6sungen\nsind.\n\nWarum sollte das Meer jedoch\nsaure Eigenschaften aufweisen?","fontSize":7.202457384013482,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"ywZpaqnesJ-cL7kElOa81","originalText":"Ihr wisst jetzt, dass die Muscheln empfindlich gegen\u00fcber sauren L\u00f6sungen sind.\n\nWarum sollte das Meer jedoch saure Eigenschaften aufweisen?","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"FFxY7UZYlI5lc1FlyyugL","type":"rectangle","x":1250.1339594937533,"y":1279.0686330472292,"width":130.22062910377923,"height":85.1743835403026,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ui","roundness":null,"seed":428352750,"version":226,"versionNonce":810955017,"isDeleted":false,"boundElements":[{"type":"text","id":"9kSYtfi82PlZA3tV6KDd_"},{"id":"6bzTnU9k9LI4_1AMTwwsQ","type":"arrow"},{"id":"OS_uvhkdMka_ZXiQXfY5i","type":"arrow"},{"id":"qiMQz9FGFsB2nBPsGpLqN","type":"arrow"}],"updated":1794407256137,"created":1791537173542,"link":null,"locked":false},{"id":"9kSYtfi82PlZA3tV6KDd_","type":"text","x":1259.2965761213447,"y":1288.6140380991596,"width":111.89539584859621,"height":66.08357343644168,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uj","roundness":null,"seed":16238510,"version":163,"versionNonce":464001865,"isDeleted":false,"boundElements":[],"updated":1794407085752,"created":1791537174285,"link":null,"locked":false,"text":" Immer mehr CO2 wird in die Luft geleitet\nund dadurch im Meer gel\u00f6st. Das CO2\nstammt z. B. aus Abgasen von Autos oder\nIndustriefabriken.\n\nKohlenstoffdioxid, in Wasser gel\u00f6st, kennt\nihr bereits von Sprudelwasser unter dem\numgangssprachlichen Namen\n\"Kohlens\u00e4ure\".","fontSize":5.874095416572593,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"FFxY7UZYlI5lc1FlyyugL","originalText":" Immer mehr CO2 wird in die Luft geleitet und dadurch im Meer gel\u00f6st. Das CO2 stammt z. B. aus Abgasen von Autos oder Industriefabriken.\n\nKohlenstoffdioxid, in Wasser gel\u00f6st, kennt ihr bereits von Sprudelwasser unter dem umgangssprachlichen Namen \"Kohlens\u00e4ure\".","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"QuxwVt6MY05K5s1q4It5j","type":"rectangle","x":1161.731149516472,"y":1467.771211798746,"width":114.34922431911822,"height":84.40061726504099,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ul","roundness":null,"seed":1762661550,"version":186,"versionNonce":1163890439,"isDeleted":false,"boundElements":[{"type":"text","id":"SSVT2kVQyi1IzDpOyZjfi"},{"id":"qiMQz9FGFsB2nBPsGpLqN","type":"arrow"},{"id":"GzUQumZvnzo08NH8Z9gKg","type":"arrow"}],"updated":1794407287496,"created":1791537233556,"link":null,"locked":false},{"id":"SSVT2kVQyi1IzDpOyZjfi","type":"text","x":1170.7137926615735,"y":1477.9796338063347,"width":96.38393802891504,"height":63.98377324986335,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3um","roundness":null,"seed":1278824302,"version":112,"versionNonce":191635559,"isDeleted":false,"boundElements":[],"updated":1794407254909,"created":1791537234299,"link":null,"locked":false,"text":"Durch das experimentelle\nUntersuchen der\nEigenschaften von\nSprudelwasser k\u00f6nnen damit\nR\u00fcckschl\u00fcsse auf das\nVerhalten im Meer getroffen\nwerden.","fontSize":7.312431228555812,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"QuxwVt6MY05K5s1q4It5j","originalText":"Durch das experimentelle Untersuchen der Eigenschaften von Sprudelwasser k\u00f6nnen damit R\u00fcckschl\u00fcsse auf das Verhalten im Meer getroffen werden.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"uKiBwj0JcXCUXehqG4u3-","type":"rectangle","x":805.0158588105296,"y":1291.0720805602832,"width":207.90067837906003,"height":114.3690608529504,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uq","roundness":null,"seed":796994094,"version":185,"versionNonce":721788455,"isDeleted":false,"boundElements":[{"type":"text","id":"AbvkS8j6R1U-voWannceW"},{"id":"GzUQumZvnzo08NH8Z9gKg","type":"arrow"},{"id":"bnAmpxt4MvoVXKyKMhs_0","type":"arrow"},{"id":"1ocbXIYyuOmDg4vGy_zCi","type":"arrow"}],"updated":1794407422294,"created":1791537297498,"link":null,"locked":false},{"id":"AbvkS8j6R1U-voWannceW","type":"text","x":810.0158588105296,"y":1302.7844783184917,"width":191.24000549316406,"height":90.94426533653346,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ur","roundness":null,"seed":1570878386,"version":122,"versionNonce":1337232649,"isDeleted":false,"boundElements":[],"updated":1794407364131,"created":1791537298096,"link":null,"locked":false,"text":"Experiment F: pH-Wert und Kohlenstoffdioxid\n\nAnleitung:\n1.) F\u00fcllt in die Bechergl\u00e4ser jeweils Wasser und Sprudelwasser.\n2.) Nehmt euch zwei pH-Streifen und haltet jeweils einen der\nStreifen in ein Becherglas.\n3.) Nach 5 Sekunden k\u00f6nnt ihr sie herausnehmen.\n4.) Ordnet den Farben mit Hilfe der Verpackung den pH-Wert zu\nund notiert euch die Werte.\n5.) R\u00e4umt anschlie\u00dfend den Platz auf und achtet darauf, dass\nalles trocken ist.","fontSize":6.614128388111524,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"uKiBwj0JcXCUXehqG4u3-","originalText":"Experiment F: pH-Wert und Kohlenstoffdioxid\n\nAnleitung:\n1.) F\u00fcllt in die Bechergl\u00e4ser jeweils Wasser und Sprudelwasser.\n2.) Nehmt euch zwei pH-Streifen und haltet jeweils einen der Streifen in ein Becherglas.\n3.) Nach 5 Sekunden k\u00f6nnt ihr sie herausnehmen.\n4.) Ordnet den Farben mit Hilfe der Verpackung den pH-Wert zu und notiert euch die Werte.\n5.) R\u00e4umt anschlie\u00dfend den Platz auf und achtet darauf, dass alles trocken ist.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"n2BcyGjSRZBQ8AyBrLIsJ","type":"rectangle","x":495.84094235068847,"y":1031.8116040319228,"width":235.9268080541672,"height":134.46464141331185,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ut","roundness":null,"seed":374698674,"version":209,"versionNonce":169333095,"isDeleted":false,"boundElements":[{"type":"text","id":"v1n9dG9KNcq-K9ENC3Xkj"},{"id":"1ocbXIYyuOmDg4vGy_zCi","type":"arrow"},{"id":"wbHeR76Im_ZRns_aNIiwu","type":"arrow"},{"id":"JZJHkTm1J3HpPv18oCRNI","type":"arrow"}],"updated":1794407483167,"created":1791537314825,"link":null,"locked":false},{"id":"v1n9dG9KNcq-K9ENC3Xkj","type":"text","x":506.47402519801483,"y":1045.4759817405627,"width":214.6606423595144,"height":107.13588599603189,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uu","roundness":null,"seed":102941486,"version":128,"versionNonce":1102085481,"isDeleted":false,"boundElements":[],"updated":1794407420161,"created":1791537315372,"link":null,"locked":false,"text":"Normales Wasser reagiert neutral und Sprudelwasser\nsauer. Es scheint also an dem Kohlenstoffdioxid im\nWasser zu liegen.\n\nGrund daf\u00fcr ist, dass Kohlenstoffdioxid mit Wasser zu\ndem Stoff Kohlens\u00e4ure reagiert. Die Kohlens\u00e4ure l\u00f6st\nsich in Wasser und es entsteht eine saure L\u00f6sung.\n\nUm die gemessenen sauren Eigenschaften zu erreichen,\nmuss viel Kohlenstoffdioxid im Wasser gel\u00f6st werden.","fontSize":8.570870879682552,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"n2BcyGjSRZBQ8AyBrLIsJ","originalText":"Normales Wasser reagiert neutral und Sprudelwasser sauer. Es scheint also an dem Kohlenstoffdioxid im Wasser zu liegen.\n\nGrund daf\u00fcr ist, dass Kohlenstoffdioxid mit Wasser zu dem Stoff Kohlens\u00e4ure reagiert. Die Kohlens\u00e4ure l\u00f6st sich in Wasser und es entsteht eine saure L\u00f6sung.\n\nUm die gemessenen sauren Eigenschaften zu erreichen, muss viel Kohlenstoffdioxid im Wasser gel\u00f6st werden.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"eerupmOkAtqf2x0rIaO7y","type":"rectangle","x":516.5995157543628,"y":890.2606426416598,"width":176.19448107434917,"height":76.04412309857047,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uv","roundness":null,"seed":317688690,"version":204,"versionNonce":1325048871,"isDeleted":false,"boundElements":[{"type":"text","id":"ldto3sNhID7f7Hr8-I1pc"},{"id":"wbHeR76Im_ZRns_aNIiwu","type":"arrow"},{"id":"ibBuI41u-N1U1p9Q5TNgk","type":"arrow"}],"updated":1794407711287,"created":1791537339517,"link":null,"locked":false},{"id":"ldto3sNhID7f7Hr8-I1pc","type":"text","x":530.1867541553069,"y":906.7623180870729,"width":149.02000427246094,"height":43.040772207744425,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3ux","roundness":null,"seed":1764666670,"version":133,"versionNonce":352603591,"isDeleted":false,"boundElements":[],"updated":1794407480346,"created":1791537340210,"link":null,"locked":false,"text":"Ihr habt nun alle Informationen, die ihr ben\u00f6tigt.\n\nAufgabe 2:\nBeschreibt im Projektheft nun, wie es zum dem\nAbsterben der Muscheln kommt.","fontSize":6.886523553239108,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"eerupmOkAtqf2x0rIaO7y","originalText":"Ihr habt nun alle Informationen, die ihr ben\u00f6tigt.\n\nAufgabe 2:\nBeschreibt im Projektheft nun, wie es zum dem Absterben der Muscheln kommt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"LLXMPLdKTh5Hm3Ba7YqT2","type":"rectangle","x":275.96956853493293,"y":908.1140987161664,"width":174.751235690725,"height":84.1983168111477,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uy","roundness":null,"seed":679977522,"version":187,"versionNonce":1233516681,"isDeleted":false,"boundElements":[{"type":"text","id":"fqfzMuULYrKQLnyD9IVev"},{"id":"JZJHkTm1J3HpPv18oCRNI","type":"arrow"},{"id":"OYaleUfHkx7ee8pD3Y2OJ","type":"arrow"}],"updated":1794407624494,"created":1791537362576,"link":null,"locked":false},{"id":"fqfzMuULYrKQLnyD9IVev","type":"text","x":287.645680702174,"y":921.3232557634889,"width":151.39901135624282,"height":57.78000271650281,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3uz","roundness":null,"seed":1256513266,"version":93,"versionNonce":1218523655,"isDeleted":false,"boundElements":[],"updated":1794407525911,"created":1791537363533,"link":null,"locked":false,"text":"Die Natur hat M\u00f6glichkeiten solchen\nSituationen entgegenzuwirken.\nPlankton im Meer ist in der Lage\nKohlenstoffdioxid umzuwandeln in\nSauerstoff und andere Stoffe.","fontSize":9.24480043464045,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"LLXMPLdKTh5Hm3Ba7YqT2","originalText":"Die Natur hat M\u00f6glichkeiten solchen Situationen entgegenzuwirken. Plankton im Meer ist in der Lage Kohlenstoffdioxid umzuwandeln in Sauerstoff und andere Stoffe.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"P89VN2cgoYmCA6Vc6ZajI","type":"rectangle","x":133.02620893909187,"y":748.3433970989128,"width":148.54421892816924,"height":93,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffb77c","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3v","roundness":null,"seed":1820476334,"version":180,"versionNonce":466247015,"isDeleted":false,"boundElements":[{"type":"text","id":"xsri4nTEfBLS6dCcTxnF0"},{"id":"OYaleUfHkx7ee8pD3Y2OJ","type":"arrow"},{"id":"M76vwpu6_USYkCYcSGhRI","type":"arrow"}],"updated":1794407851169,"created":1791537376006,"link":"https://www.geogebra.org/m/crd36htk","locked":false},{"id":"xsri4nTEfBLS6dCcTxnF0","type":"text","x":138.17831565659446,"y":753.7376125259542,"width":138.24000549316406,"height":82.21156914591704,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3v2","roundness":null,"seed":1989703346,"version":225,"versionNonce":1360121097,"isDeleted":false,"boundElements":[],"updated":1794407733311,"created":1791537376849,"link":null,"locked":false,"text":"\nDas Plankton ist jedoch auch anf\u00e4llig gegen\u00fcber einer\nsauren Umgebung.\nDas bietet Potential f\u00fcr eine Versch\u00e4rfung der Situation.\n\nAufgabe 3:\nUm dies zu verdeutlichen, stellt die logischen\nZusammenh\u00e4nge auf der Website her, die sich \u00f6ffnet,\nwenn ihr auf diese Kachel klickt.\n\n\u00dcbertragt die L\u00fccken ins Projektheft, wenn alles richtig\nist.","fontSize":5.480771276394469,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"P89VN2cgoYmCA6Vc6ZajI","originalText":"\nDas Plankton ist jedoch auch anf\u00e4llig gegen\u00fcber einer sauren Umgebung.\nDas bietet Potential f\u00fcr eine Versch\u00e4rfung der Situation.\n\nAufgabe 3:\nUm dies zu verdeutlichen, stellt die logischen Zusammenh\u00e4nge auf der Website her, die sich \u00f6ffnet, wenn ihr auf diese Kachel klickt.\n\n\u00dcbertragt die L\u00fccken ins Projektheft, wenn alles richtig ist.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"_ytYStL3HUbOUACKjWHPq","type":"rectangle","x":-235.18492732919668,"y":431.18108524471006,"width":169.82069620404957,"height":171.5689897152808,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3v4","roundness":null,"seed":635738350,"version":95,"versionNonce":2079303273,"isDeleted":false,"boundElements":[{"type":"text","id":"FdkE52d-HC2Yy6Ppn2KZ0"},{"id":"1F_4j9MU8LCI2OUrQnX82","type":"arrow"},{"id":"feRu8EvBuTBxsOkntSbty","type":"arrow"}],"updated":1794407998975,"created":1791537724628,"link":null,"locked":false},{"id":"FdkE52d-HC2Yy6Ppn2KZ0","type":"text","x":-226.8794857316131,"y":443.853794712316,"width":153.2098130088824,"height":146.22357078006883,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3v6","roundness":null,"seed":200906162,"version":37,"versionNonce":113826119,"isDeleted":false,"boundElements":[],"updated":1794407855034,"created":1791537744164,"link":null,"locked":false,"text":"Mit unseren Industrien, Energiewerken und\ndem Verkehr setzen wir immer mehr\nKohlenstoffdioxid (im Volksmund auch\nKohlendioxid genannt) in die Atmosph\u00e4re.\n\n\u00dcber 95 % aller Klimaforscher sind sich\ndaher einig, dass wir Menschen die\ndurchschnittliche globale Temperatur auf\nunserer Erde anheben.\n\nDennoch sind \u00fcber 35 % aller Menschen\nder Meinung, dass Kohlenstoffdioxid keinen\nEinfluss auf das Klima h\u00e4tte und lehnen die\nTheorie ab. Im Folgenden seht ihr dazu\nzwei Meinungen von Politikern.","fontSize":7.798590441603672,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"_ytYStL3HUbOUACKjWHPq","originalText":"Mit unseren Industrien, Energiewerken und dem Verkehr setzen wir immer mehr Kohlenstoffdioxid (im Volksmund auch Kohlendioxid genannt) in die Atmosph\u00e4re.\n\n\u00dcber 95 % aller Klimaforscher sind sich daher einig, dass wir Menschen die durchschnittliche globale Temperatur auf unserer Erde anheben.\n\nDennoch sind \u00fcber 35 % aller Menschen der Meinung, dass Kohlenstoffdioxid keinen Einfluss auf das Klima h\u00e4tte und lehnen die Theorie ab. Im Folgenden seht ihr dazu zwei Meinungen von Politikern.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"xQsYlrjjkR4GVsLJyLEaX","type":"rectangle","x":-66.1895448293877,"y":917.041100159256,"width":209.12772211166967,"height":123.69580502659483,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vC","roundness":null,"seed":1204289650,"version":111,"versionNonce":694962151,"isDeleted":false,"boundElements":[{"type":"text","id":"ULZdF-XXunizke16fgzVj"},{"id":"bllX9wamrmMRRm_0YHB64","type":"arrow"},{"id":"NKjtcrR1_1rTSz2gvj37d","type":"arrow"}],"updated":1794408348019,"created":1791537776489,"link":null,"locked":false},{"id":"ULZdF-XXunizke16fgzVj","type":"text","x":-60.7656831632013,"y":930.315928230635,"width":198.27999877929688,"height":97.14614888383673,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vG","roundness":null,"seed":274535282,"version":50,"versionNonce":482764871,"isDeleted":false,"boundElements":[],"updated":1794408338136,"created":1791537777235,"link":null,"locked":false,"text":"Diese Politiker sind also der Meinung, dass\ndie Wissenschaftler l\u00fcgen. Sie behaupten, es\ng\u00e4be keinen Zusammenhang zwischen einer\nglobalen Erw\u00e4rmung und der CO2-Emission\n(Emission: Aussto\u00df oder Aussendung von\nSt\u00f6rfaktoren in die Umwelt).\n\n\u00dcberpr\u00fcft selbst, wie die Fakten aussehen.","fontSize":9.714614888383673,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"xQsYlrjjkR4GVsLJyLEaX","originalText":"Diese Politiker sind also der Meinung, dass die Wissenschaftler l\u00fcgen. Sie behaupten, es g\u00e4be keinen Zusammenhang zwischen einer globalen Erw\u00e4rmung und der CO2-Emission (Emission: Aussto\u00df oder Aussendung von St\u00f6rfaktoren in die Umwelt).\n\n\u00dcberpr\u00fcft selbst, wie die Fakten aussehen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"ZvWB85yYCdGG4PB3CcHc1","type":"rectangle","x":115.55070960185171,"y":1460.3122884939944,"width":119.0271540803202,"height":102.34110325313081,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vO","roundness":null,"seed":2079595822,"version":154,"versionNonce":676466217,"isDeleted":false,"boundElements":[{"type":"text","id":"A9GPM1iNL8zfML91tAu_m"},{"id":"HPouRwB7ErEiPTSBy0f-a","type":"arrow"},{"id":"tcUvXq8wXj9hxMAZQr7-E","type":"arrow"}],"updated":1794408398314,"created":1791537808985,"link":null,"locked":false},{"id":"A9GPM1iNL8zfML91tAu_m","type":"text","x":124.94941923449963,"y":1474.5355685298964,"width":100.22973481502437,"height":73.89454318132658,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vQ","roundness":null,"seed":1568326002,"version":101,"versionNonce":701213319,"isDeleted":false,"boundElements":[],"updated":1794408376011,"created":1791537809886,"link":null,"locked":false,"text":"\u00dcberpr\u00fcft nun den\nZusammenhang zwischen\nglobaler Erw\u00e4rmung und dem\nGas Kohlenstoffdioxid.\n\nDaf\u00fcr sollt ihr euch die\nEigenschaften des CO2 in\neinem Experiment anschauen.","fontSize":7.389454318132659,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"ZvWB85yYCdGG4PB3CcHc1","originalText":"\u00dcberpr\u00fcft nun den Zusammenhang zwischen globaler Erw\u00e4rmung und dem Gas Kohlenstoffdioxid.\n\nDaf\u00fcr sollt ihr euch die Eigenschaften des CO2 in einem Experiment anschauen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"f_G0NfUyXblDde9CIu1mn","type":"rectangle","x":-212.96755307574023,"y":1565.4276615658023,"width":276.2166652040604,"height":179,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vS","roundness":null,"seed":1099392562,"version":295,"versionNonce":524465639,"isDeleted":false,"boundElements":[{"type":"text","id":"2VBC9xH5Ftgi7kxLsaANL"},{"id":"fMzkvwyQTmOyL2Nj3Av8S","type":"arrow"},{"id":"tcUvXq8wXj9hxMAZQr7-E","type":"arrow"},{"id":"OqmnPx0Qb-usgOmVVVsK9","type":"arrow"}],"updated":1794408421589,"created":1791537825098,"link":null,"locked":false},{"id":"2VBC9xH5Ftgi7kxLsaANL","type":"text","x":-207.96755307574023,"y":1570.4836593619793,"width":259.7799987792969,"height":168.8880044076458,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vV","roundness":null,"seed":161043502,"version":129,"versionNonce":836602985,"isDeleted":false,"boundElements":[],"updated":1794408413542,"created":1791537846639,"link":null,"locked":false,"text":"Experiment G: Untersuchen des Treibhauseffekts\n\nHinweis: Die Heizplatte symbolisiert die von der Sonne erw\u00e4rmte Erdoberfl\u00e4che, welche\nW\u00e4rmestrahlung abgibt und die Atmosph\u00e4re (bedruckte Chipsdose) beinhaltet anfangs\nnormale Luft.\u00a0Der Satellit (silberner Zylinder) misst die ankommende W\u00e4rmestrahlung im\nWeltall und gibt sie als ablesbare Spannung aus.\n\nAnleitung:\n1.) Die Heizplatte ist sehr hei\u00df und darf nicht angefasst werden!\n2.) Schaltet das Spannungsmessger\u00e4t an, indem ihr die Einstellung 200 mV\nGleichspannung w\u00e4hlt und lest den Startwert ab.\n3.) F\u00fcllt ca. 200 ml frisches Wasser in den Glaskolben.\n4.) Stellt nun CO2 her, indem ihr einen gestrichenen L\u00f6ffel des wei\u00dfen Pulvers  in den\nGlaskolben gebt und ihn sofort fest mit dem Gummistopfen verschlie\u00dft.\n5.) Schwenkt den Glaskolben vorsichtig.\n6.) Beobachtet die Ver\u00e4nderung des Wertes am Spannungsmessger\u00e4t und notiert ihn.\n7.) Entfernt den schwarzen Mini-Stopfen links unten an der Dose, um das CO2 wieder\nentweichen zu lassen.\n8.) Beschreibt im Projektheft, welchen Einfluss das CO2 auf die ankommende\nW\u00e4rmestrahlung am \"Satelliten\" hat und welche R\u00fcckschl\u00fcsse ihr auf die\nTemperaturentwicklung auf der Erde ziehen k\u00f6nnt.","fontSize":6.433828739338888,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"f_G0NfUyXblDde9CIu1mn","originalText":"Experiment G: Untersuchen des Treibhauseffekts\n\nHinweis: Die Heizplatte symbolisiert die von der Sonne erw\u00e4rmte Erdoberfl\u00e4che, welche W\u00e4rmestrahlung abgibt und die Atmosph\u00e4re (bedruckte Chipsdose) beinhaltet anfangs normale Luft.\u00a0Der Satellit (silberner Zylinder) misst die ankommende W\u00e4rmestrahlung im Weltall und gibt sie als ablesbare Spannung aus.\n\nAnleitung:\n1.) Die Heizplatte ist sehr hei\u00df und darf nicht angefasst werden!\n2.) Schaltet das Spannungsmessger\u00e4t an, indem ihr die Einstellung 200 mV Gleichspannung w\u00e4hlt und lest den Startwert ab.\n3.) F\u00fcllt ca. 200 ml frisches Wasser in den Glaskolben.\n4.) Stellt nun CO2 her, indem ihr einen gestrichenen L\u00f6ffel des wei\u00dfen Pulvers  in den Glaskolben gebt und ihn sofort fest mit dem Gummistopfen verschlie\u00dft.\n5.) Schwenkt den Glaskolben vorsichtig.\n6.) Beobachtet die Ver\u00e4nderung des Wertes am Spannungsmessger\u00e4t und notiert ihn.\n7.) Entfernt den schwarzen Mini-Stopfen links unten an der Dose, um das CO2 wieder entweichen zu lassen.\n8.) Beschreibt im Projektheft, welchen Einfluss das CO2 auf die ankommende W\u00e4rmestrahlung am \"Satelliten\" hat und welche R\u00fcckschl\u00fcsse ihr auf die Temperaturentwicklung auf der Erde ziehen k\u00f6nnt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"pe40OpaJiV48vE9cUStmX","type":"rectangle","x":-397.5967674839206,"y":1357.420944245023,"width":126.92702843872348,"height":126.92702843872348,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vX","roundness":null,"seed":425015022,"version":71,"versionNonce":689887273,"isDeleted":false,"boundElements":[{"type":"text","id":"jhRnpeOAQXDxWgvB_KJMy"},{"id":"fMzkvwyQTmOyL2Nj3Av8S","type":"arrow"},{"id":"HHFTWxhZvgQuO1389cCMx","type":"arrow"}],"updated":1794408507817,"created":1791537867502,"link":null,"locked":false},{"id":"jhRnpeOAQXDxWgvB_KJMy","type":"text","x":-391.3320479405368,"y":1370.1393974097898,"width":114.39758935195592,"height":101.49012210918994,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vZ","roundness":null,"seed":371506802,"version":35,"versionNonce":1935151143,"isDeleted":false,"boundElements":[],"updated":1794408489347,"created":1791537868215,"link":null,"locked":false,"text":"Wenn eine h\u00f6here Spannung also auch\nmehr W\u00e4rmestrahlung gemessen wird,\ndann l\u00e4sst das betrachtete Gas mehr\nStrahlung durch:\nDas Gas\u00a0transmittiert W\u00e4rmestrahlung.\u00a0\n\nWenn weniger Spannung also auch\nweniger W\u00e4rmestrahlung gemessen\nwird, dann nimmt das Gas die Strahlung\nauf: Das Gas absorbiert\nW\u00e4rmestrahlung.\nDanach wird die W\u00e4rmestrahlung in alle\nRichtungen verteilt wieder abgegeben.","fontSize":6.24554597595015,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"pe40OpaJiV48vE9cUStmX","originalText":"Wenn eine h\u00f6here Spannung also auch mehr W\u00e4rmestrahlung gemessen wird, dann l\u00e4sst das betrachtete Gas mehr Strahlung durch:\nDas Gas\u00a0transmittiert W\u00e4rmestrahlung.\u00a0\n\nWenn weniger Spannung also auch weniger W\u00e4rmestrahlung gemessen wird, dann nimmt das Gas die Strahlung auf: Das Gas absorbiert W\u00e4rmestrahlung.\nDanach wird die W\u00e4rmestrahlung in alle Richtungen verteilt wieder abgegeben.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"XjziIaElZkDrM6FM-raua","type":"rectangle","x":-387.12171215926975,"y":1164.3350381051134,"width":133.01146710680564,"height":86,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vd","roundness":null,"seed":335183662,"version":303,"versionNonce":1943673927,"isDeleted":false,"boundElements":[{"type":"text","id":"zAXnnjgigJIwe6Dg-u8bB"},{"id":"HHFTWxhZvgQuO1389cCMx","type":"arrow"},{"id":"k4y6ZPxpbx6QPaxZ-oUk5","type":"arrow"}],"updated":1794408641156,"created":1791537876385,"link":"https://www.geogebra.org/m/ghwpamsh","locked":false},{"id":"zAXnnjgigJIwe6Dg-u8bB","type":"text","x":-376.465977079988,"y":1169.494936595839,"width":111.69999694824219,"height":75.68020301854895,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vf","roundness":null,"seed":2118349934,"version":278,"versionNonce":178943591,"isDeleted":false,"boundElements":[],"updated":1794408543449,"created":1791537876920,"link":null,"locked":false,"text":"Aufgabe 2:\nNutzt eure Erfahrungen aus dem\nExperiment und l\u00f6st den L\u00fcckentext,\nder sich \u00f6ffnet, wenn ihr auf diese\nKachel tippt.\n\n\u00dcbertragt die L\u00fccken ins Projektheft,\nwenn alles richtig ist.\n","fontSize":6.727129157204351,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"XjziIaElZkDrM6FM-raua","originalText":"Aufgabe 2:\nNutzt eure Erfahrungen aus dem Experiment und l\u00f6st den L\u00fcckentext, der sich \u00f6ffnet, wenn ihr auf diese Kachel tippt.\n\n\u00dcbertragt die L\u00fccken ins Projektheft, wenn alles richtig ist.\n","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"k2KFnlTrQMolgazlJBuTE","type":"rectangle","x":-494.5696028424042,"y":888.3923923785397,"width":237.46617787829186,"height":158,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vh","roundness":null,"seed":408674670,"version":106,"versionNonce":983818631,"isDeleted":false,"boundElements":[{"type":"text","id":"_5uY3KPLWG-glCZf726O3"},{"id":"k4y6ZPxpbx6QPaxZ-oUk5","type":"arrow"},{"id":"bEZrsPQpQshymYZI5Ck1a","type":"arrow"}],"updated":1794408661280,"created":1791537912015,"link":"https://www.geogebra.org/m/bmghkt5n","locked":false},{"id":"_5uY3KPLWG-glCZf726O3","type":"text","x":-488.6265148187856,"y":908.4778747845858,"width":225.5800018310547,"height":117.82903518790798,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vl","roundness":null,"seed":1918344178,"version":171,"versionNonce":1649840745,"isDeleted":false,"boundElements":[],"updated":1794408633890,"created":1791537912839,"link":null,"locked":false,"text":"Aufgabe 3:\nL\u00f6st nun die n\u00e4chste Aufgabe, die sich\n\u00f6ffnet, wenn ihr auf diese Kachel tippt. \n\nEs geht darum ein besseres Verst\u00e4ndnis\ndes Prozesses erlangen. Positioniert dabei\ndie Pfeile in der Grafik, um die Richtung\nder W\u00e4rmestrahlung darzustellen.","fontSize":11.782903518790798,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"k2KFnlTrQMolgazlJBuTE","originalText":"Aufgabe 3:\nL\u00f6st nun die n\u00e4chste Aufgabe, die sich \u00f6ffnet, wenn ihr auf diese Kachel tippt. \n\nEs geht darum ein besseres Verst\u00e4ndnis des Prozesses erlangen. Positioniert dabei die Pfeile in der Grafik, um die Richtung der W\u00e4rmestrahlung darzustellen.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"xNuN1nuHDeGPvqIJVDg0D","type":"rectangle","x":-447.74291826122965,"y":622.8235847094014,"width":158.80664244746515,"height":127.41461881288149,"angle":0,"strokeColor":"transparent","backgroundColor":"#f8a2c9","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vn","roundness":null,"seed":1722316974,"version":187,"versionNonce":1249509961,"isDeleted":false,"boundElements":[{"type":"text","id":"xrAGYZT-2Bou0ZPP20reh"},{"id":"AUSMKK4L83xSL8Aci86w4","type":"arrow"}],"updated":1794408658787,"created":1791537932278,"link":null,"locked":false},{"id":"xrAGYZT-2Bou0ZPP20reh","type":"text","x":-442.2595952064424,"y":633.9602317679111,"width":147.83999633789062,"height":105.14132469586215,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vp","roundness":null,"seed":225875694,"version":140,"versionNonce":1296081673,"isDeleted":false,"boundElements":[],"updated":1794408683872,"created":1791537932957,"link":null,"locked":false,"text":"Aufgabe 4:\nPositioniert euch im Projektheft zu dem\nZusammenhang zwischen globaler\nErw\u00e4rmung und der zunehmenden Menge an\nKohlenstoffdioxid in der Atmosph\u00e4re. Wie\nbewertet ihr zu den Aussagen der Politiker am\nAnfang der Mission?\n\nBITTE: Steckt den schwarzen Mini-Stopfen\nwieder in die Dose, bevor ihr zur n\u00e4chsten\nMission geht und gie\u00dft die Fl\u00fcssigkeit ins\nWaschbecken.","fontSize":7.00942164639081,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"xNuN1nuHDeGPvqIJVDg0D","originalText":"Aufgabe 4:\nPositioniert euch im Projektheft zu dem Zusammenhang zwischen globaler Erw\u00e4rmung und der zunehmenden Menge an Kohlenstoffdioxid in der Atmosph\u00e4re. Wie bewertet ihr zu den Aussagen der Politiker am Anfang der Mission?\n\nBITTE: Steckt den schwarzen Mini-Stopfen wieder in die Dose, bevor ihr zur n\u00e4chsten Mission geht und gie\u00dft die Fl\u00fcssigkeit ins Waschbecken.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"yt-pjR8aeKPutB6yq8bwp","type":"rectangle","x":-504.30197901717366,"y":159.3753765166365,"width":141.2984550869054,"height":79.83135971547341,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vt","roundness":null,"seed":274776238,"version":155,"versionNonce":1693433193,"isDeleted":false,"boundElements":[{"type":"text","id":"uUhNHLU7mmOGtdzMioJ61"},{"id":"iqMjhyaAWvtz5dKVYSqjO","type":"arrow"},{"id":"XtH60A4ez3TSHcOMApTf8","type":"arrow"}],"updated":1794410058093,"created":1791538117279,"link":null,"locked":false},{"id":"uUhNHLU7mmOGtdzMioJ61","type":"text","x":-494.67275193148464,"y":169.92351611724405,"width":122.04000091552734,"height":58.73508051425827,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vv","roundness":null,"seed":1337855470,"version":70,"versionNonce":1543088583,"isDeleted":false,"boundElements":[],"updated":1794409454304,"created":1791538186952,"link":null,"locked":false,"text":"Wie kann das Problem mit den\nTreibhausgasen und den steigenden\nTemperaturen gel\u00f6st werden?\n\nCeline sagt zuversichtlich: \u201eDie Natur\nregelt das schon, wof\u00fcr gibt es denn die\nMeere?\"  ","fontSize":6.712580630200945,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"yt-pjR8aeKPutB6yq8bwp","originalText":"Wie kann das Problem mit den Treibhausgasen und den steigenden Temperaturen gel\u00f6st werden?\n\nCeline sagt zuversichtlich: \u201eDie Natur regelt das schon, wof\u00fcr gibt es denn die Meere?\"  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"-OtgjPsBKd0Z5XbUTi1kp","type":"rectangle","x":-561.4329619121129,"y":288.1766503845138,"width":117.48588575772035,"height":80,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3vx","roundness":null,"seed":2115463534,"version":331,"versionNonce":607643817,"isDeleted":false,"boundElements":[{"type":"text","id":"_4I5XyTWmx7PzmW9j6X9_"},{"id":"XtH60A4ez3TSHcOMApTf8","type":"arrow"},{"id":"EBZLX0Bq8-TEU7QNw6Bv6","type":"arrow"}],"updated":1794410062229,"created":1791538203451,"link":null,"locked":false},{"id":"_4I5XyTWmx7PzmW9j6X9_","type":"text","x":-554.4700178125496,"y":293.2105054166957,"width":103.55999755859375,"height":69.93228993563625,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3w","roundness":null,"seed":1989042926,"version":119,"versionNonce":738283177,"isDeleted":false,"boundElements":[],"updated":1794409470393,"created":1791538204436,"link":null,"locked":false,"text":"Was meint sie damit?\n\nWie soll Wasser die\nL\u00f6sung f\u00fcr die steigende\nCO2-Konzentration in\nunserer Luft sein?  ","fontSize":9.324305324751501,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"-OtgjPsBKd0Z5XbUTi1kp","originalText":"Was meint sie damit?\n\nWie soll Wasser die L\u00f6sung f\u00fcr die steigende CO2-Konzentration in unserer Luft sein?  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"IkAci99NeEGGfPM3ju9nU","type":"rectangle","x":-717.619264688328,"y":448.19453030210576,"width":202.6474334154037,"height":157.86597238526258,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3w4","roundness":null,"seed":268372018,"version":159,"versionNonce":1532059785,"isDeleted":false,"boundElements":[{"type":"text","id":"Amtein2m4yNJZV7JEvEOb"},{"id":"EBZLX0Bq8-TEU7QNw6Bv6","type":"arrow"},{"id":"k4BeMB3Ri4OUsmCiWb06o","type":"arrow"}],"updated":1794410068827,"created":1791538216966,"link":null,"locked":false},{"id":"Amtein2m4yNJZV7JEvEOb","type":"text","x":-711.6355443185168,"y":457.47626397731585,"width":190.67999267578125,"height":139.30250503484245,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3w8","roundness":null,"seed":281122670,"version":84,"versionNonce":720268039,"isDeleted":false,"boundElements":[],"updated":1794409491163,"created":1791538218130,"link":null,"locked":false,"text":"Kohlenstoffdioxid kann in Wasser gel\u00f6st\nwerden, wie ihr es vom Sprudelwasser kennt.\n\nBei Sprudelwasser wird das CO2\nreingepumpt (z. B. mit einem \"Sodastream\").\nM\u00fcssen wir also nur das CO2 aus der\nAtmosph\u00e4re in die Meere pumpen um das\nProblem zu l\u00f6sen?\n\nUm einzusch\u00e4tzen, ob sich das lohnt, sollten\nwir uns die nat\u00fcrliche Bewegung der\nGasteilchen anschauen.  ","fontSize":9.286833668989496,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"IkAci99NeEGGfPM3ju9nU","originalText":"Kohlenstoffdioxid kann in Wasser gel\u00f6st werden, wie ihr es vom Sprudelwasser kennt.\n\nBei Sprudelwasser wird das CO2 reingepumpt (z. B. mit einem \"Sodastream\"). M\u00fcssen wir also nur das CO2 aus der Atmosph\u00e4re in die Meere pumpen um das Problem zu l\u00f6sen?\n\nUm einzusch\u00e4tzen, ob sich das lohnt, sollten wir uns die nat\u00fcrliche Bewegung der Gasteilchen anschauen.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"MVGOOXY58ygqeOtVmwP30","type":"rectangle","x":-846.7284670563337,"y":1053.6188982789474,"width":212.8672876954801,"height":282.71989957927815,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wK","roundness":null,"seed":1423991986,"version":173,"versionNonce":74144457,"isDeleted":false,"boundElements":[{"type":"text","id":"MDST9gr3fD7ADkyXNv8nH"},{"id":"v10M1Pq9DJ6OQ0lbPukoO","type":"arrow"},{"id":"jPv0qkcTRuQuewJaWum_N","type":"arrow"}],"updated":1794410076896,"created":1791538285555,"link":null,"locked":false},{"id":"MDST9gr3fD7ADkyXNv8nH","type":"text","x":-832.4748235137694,"y":1058.6188982789474,"width":184.36000061035156,"height":60.45811176307407,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wO","roundness":null,"seed":218042738,"version":119,"versionNonce":850525129,"isDeleted":false,"boundElements":[],"updated":1794409657055,"created":1791538286506,"link":null,"locked":false,"text":"\nDie Bewegung der Gasteilchen stoppt nie, jedoch\nergibt sich irgendwann ein Punkt, an dem der\nL\u00f6sevorgang und die Freisetzung des Gases gleich\nschnell ablaufen. Dieser Punkt wird Gleichgewicht\ngenannt.","fontSize":8.061081568409877,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"MVGOOXY58ygqeOtVmwP30","originalText":"\nDie Bewegung der Gasteilchen stoppt nie, jedoch ergibt sich irgendwann ein Punkt, an dem der L\u00f6sevorgang und die Freisetzung des Gases gleich schnell ablaufen. Dieser Punkt wird Gleichgewicht genannt.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"D4Tiujl0uTt7V499lxL_O","type":"rectangle","x":-1115.4668664290307,"y":1191.7847352204046,"width":168.99073209321168,"height":168.99073209321168,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wV","roundness":null,"seed":1014330226,"version":74,"versionNonce":1165502665,"isDeleted":false,"boundElements":[{"type":"text","id":"el-SaRYf860c98YR6hrv-"},{"id":"jPv0qkcTRuQuewJaWum_N","type":"arrow"},{"id":"aICKOPMbmv9ZME1dhlZ1j","type":"arrow"}],"updated":1794410079515,"created":1791538345309,"link":null,"locked":false},{"id":"el-SaRYf860c98YR6hrv-","type":"text","x":-1110.3614997720733,"y":1213.3253773816507,"width":158.77999877929688,"height":125.90944777071942,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wZ","roundness":null,"seed":1433601650,"version":43,"versionNonce":1800342729,"isDeleted":false,"boundElements":[],"updated":1794409809084,"created":1791538346086,"link":null,"locked":false,"text":"Im Gleichgewicht liegt eine konstante\nKonzentration von Kohlenstoffdioxid in\nder Fl\u00fcssigkeit vor, die\nS\u00e4ttigungskonzentration.\n\nDie S\u00e4ttigungskonzentration ist abh\u00e4ngig\nvon der Menge an Kohlenstoffdioxid in\nder Fl\u00fcssigkeit und dem (Partial-)Druck in\nder Gasphase (Bereich mit Gas) \u00fcber der\nFl\u00fcssigkeit. Dieser Druck ist abh\u00e4ngig von\nder Menge des Kohlenstoffdioxides in der\nGasphase, aber auch von der Temperatur.","fontSize":8.393963184714629,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"D4Tiujl0uTt7V499lxL_O","originalText":"Im Gleichgewicht liegt eine konstante Konzentration von Kohlenstoffdioxid in der Fl\u00fcssigkeit vor, die S\u00e4ttigungskonzentration.\n\nDie S\u00e4ttigungskonzentration ist abh\u00e4ngig von der Menge an Kohlenstoffdioxid in der Fl\u00fcssigkeit und dem (Partial-)Druck in der Gasphase (Bereich mit Gas) \u00fcber der Fl\u00fcssigkeit. Dieser Druck ist abh\u00e4ngig von der Menge des Kohlenstoffdioxides in der Gasphase, aber auch von der Temperatur.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"QNDpO2-46ZhL4KszV_PWw","type":"rectangle","x":-1246.0855265746113,"y":1444.6579527040324,"width":140.48418673033242,"height":81.21742045347342,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wd","roundness":null,"seed":1993083122,"version":212,"versionNonce":85819207,"isDeleted":false,"boundElements":[{"type":"text","id":"hffNF86TKam8XfKDoQ-Tz"},{"id":"aICKOPMbmv9ZME1dhlZ1j","type":"arrow"},{"id":"tCtxv0_r1WVwJvZCS75jZ","type":"arrow"}],"updated":1794410083206,"created":1791538360773,"link":null,"locked":false},{"id":"hffNF86TKam8XfKDoQ-Tz","type":"text","x":-1238.3322621665022,"y":1457.100214572645,"width":124.97765791411446,"height":56.33289671624817,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wl","roundness":null,"seed":1348456562,"version":139,"versionNonce":1740839495,"isDeleted":false,"boundElements":[],"updated":1794409814284,"created":1791538361470,"link":null,"locked":false,"text":"Je mehr Kohlenstoffdioxid in der\nGasphase ist, desto gr\u00f6\u00dfer ist der\nPartialdruck und umso h\u00f6her ist die\nS\u00e4ttigungskonzentration. Somit kann\nmehr Kohlenstoffdioxid gel\u00f6st\nwerden.  ","fontSize":7.511052895499757,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"QNDpO2-46ZhL4KszV_PWw","originalText":"Je mehr Kohlenstoffdioxid in der Gasphase ist, desto gr\u00f6\u00dfer ist der Partialdruck und umso h\u00f6her ist die S\u00e4ttigungskonzentration. Somit kann mehr Kohlenstoffdioxid gel\u00f6st werden.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"hM0Vn52jk_w1Gtz4WR_sd","type":"rectangle","x":-1487.9238774380474,"y":1342.3589581790754,"width":164.18403579621398,"height":91.51240098714878,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wp","roundness":null,"seed":43650094,"version":263,"versionNonce":1249284809,"isDeleted":false,"boundElements":[{"type":"text","id":"IKqDwW0uWzyKH-Mn5CaTq"},{"id":"tCtxv0_r1WVwJvZCS75jZ","type":"arrow"},{"id":"hvcHiuJ63H1pdF9sYfImL","type":"arrow"}],"updated":1794410085431,"created":1791538380963,"link":null,"locked":false},{"id":"IKqDwW0uWzyKH-Mn5CaTq","type":"text","x":-1475.1691715342743,"y":1358.51194283391,"width":138.6746239886677,"height":59.20643167747966,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3wt","roundness":null,"seed":1825279982,"version":160,"versionNonce":1930694599,"isDeleted":false,"boundElements":[],"updated":1794409819506,"created":1791538381824,"link":null,"locked":false,"text":"Also scheint Celine ja recht zu haben?\nWenn mehr CO2 in die Atmosph\u00e4re\ngelangt, bewegen sich auch mehr\nGasteilchen ins Wasser.    Die Ozeanen\nspeichern also einen Teil unseres\nerzeugten CO2.  ","fontSize":7.894190890330622,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"hM0Vn52jk_w1Gtz4WR_sd","originalText":"Also scheint Celine ja recht zu haben?   Wenn mehr CO2 in die Atmosph\u00e4re gelangt, bewegen sich auch mehr Gasteilchen ins Wasser.    Die Ozeanen speichern also einen Teil unseres erzeugten CO2.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"Pj3rRicX0F1UsGiv6O7N4","type":"rectangle","x":-1411.6354610662338,"y":1109.1371850972603,"width":166.55323533550032,"height":123.19025561461515,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3x","roundness":null,"seed":344202482,"version":210,"versionNonce":206925225,"isDeleted":false,"boundElements":[{"type":"text","id":"i6CiyPFR7L7Z4A-LEirqK"},{"id":"hvcHiuJ63H1pdF9sYfImL","type":"arrow"},{"id":"7PWbonxxfbwYwsBxQaegd","type":"arrow"}],"updated":1794410089429,"created":1791538399598,"link":null,"locked":false},{"id":"i6CiyPFR7L7Z4A-LEirqK","type":"text","x":-1401.3427474205325,"y":1132.7945109072891,"width":145.9678080440976,"height":75.87560399455744,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3x8","roundness":null,"seed":360876654,"version":127,"versionNonce":407449575,"isDeleted":false,"boundElements":[],"updated":1794409825621,"created":1791538400416,"link":null,"locked":false,"text":"Hat der steigende Meerespiegel\naufgrund der weiterhin\nsteigenden Temperaturen also\nvielleicht doch auch einen\nVorteil? Immerhin kann so mehr\nCO2 gespeichert werden.  ","fontSize":10.116747199274327,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"Pj3rRicX0F1UsGiv6O7N4","originalText":"Hat der steigende Meerespiegel aufgrund der weiterhin steigenden Temperaturen also vielleicht doch auch einen Vorteil? Immerhin kann so mehr CO2 gespeichert werden.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"MhGiAIHVE8q6HEEgBVyPz","type":"rectangle","x":-1507.0664224161737,"y":884.8050877102863,"width":238.93781278307742,"height":146.75700409195943,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xG","roundness":null,"seed":2099732530,"version":88,"versionNonce":830225897,"isDeleted":false,"boundElements":[{"type":"text","id":"ybveiIvl1tuJL8p339z8F"},{"id":"HF1QCpXU7XlPTPXQlD5Iq","type":"arrow"}],"updated":1794410096041,"created":1791538416196,"link":null,"locked":false},{"id":"ybveiIvl1tuJL8p339z8F","type":"text","x":-1501.9175157194593,"y":913.9321680714871,"width":228.63999938964844,"height":88.50284336955781,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xV","roundness":null,"seed":365131438,"version":67,"versionNonce":1343762983,"isDeleted":false,"boundElements":[],"updated":1794409861047,"created":1791538416993,"link":null,"locked":false,"text":"Schaut euch das folgende Experiment an, bei dem die L\u00f6slichkeit von\nCO2 in Wasser untersucht wird.\n\nAls Ma\u00df f\u00fcr die Menge an gel\u00f6sten Kohlenstoffdioxid wird der pH-Wert\nverwendet. CO2 reagiert mit Wasser zu Kohlens\u00e4ure, welche in Wasser\ngel\u00f6st einen niedrigen pH-Wert hat. \n\nJe niedriger der pH-Wert ist, desto mehr Kohlens\u00e4ure liegt vor und\ndesto mehr CO2 ist gel\u00f6st. Umgekehrt bedeutet ein h\u00f6herer pH-Wert,\ndass im Vergleich weniger CO2 gel\u00f6st ist.  ","fontSize":7.080227469564624,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"MhGiAIHVE8q6HEEgBVyPz","originalText":"Schaut euch das folgende Experiment an, bei dem die L\u00f6slichkeit von CO2 in Wasser untersucht wird.\n\nAls Ma\u00df f\u00fcr die Menge an gel\u00f6sten Kohlenstoffdioxid wird der pH-Wert verwendet. CO2 reagiert mit Wasser zu Kohlens\u00e4ure, welche in Wasser gel\u00f6st einen niedrigen pH-Wert hat. \n\nJe niedriger der pH-Wert ist, desto mehr Kohlens\u00e4ure liegt vor und desto mehr CO2 ist gel\u00f6st. Umgekehrt bedeutet ein h\u00f6herer pH-Wert, dass im Vergleich weniger CO2 gel\u00f6st ist.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"asykhI_265XWZuXaJnKK7","type":"rectangle","x":-1348.916965665981,"y":650.107348702699,"width":352.7304530056869,"height":187.04008845415828,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xd","roundness":null,"seed":1878137902,"version":1251,"versionNonce":1457035273,"isDeleted":false,"boundElements":[{"type":"text","id":"MN8cIli2wbAw_1IMNMaX8"},{"id":"HF1QCpXU7XlPTPXQlD5Iq","type":"arrow"},{"id":"p28ib4RCdzcU4AHHagqUk","type":"arrow"},{"id":"nuCZ0XxH9l5Uiqjp3jGHP","type":"arrow"}],"updated":1794410108260,"created":1791538428767,"link":null,"locked":false},{"id":"MN8cIli2wbAw_1IMNMaX8","type":"text","x":-1343.916965665981,"y":666.2054107876704,"width":338.7200012207031,"height":154.84396428421553,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3xl","roundness":null,"seed":1296670002,"version":682,"versionNonce":1857846313,"isDeleted":false,"boundElements":[],"updated":1794409902879,"created":1791538429552,"link":null,"locked":false,"text":"Experiment H: Temperatur, Wasser und CO2\n\nAnleitung: \n1.) F\u00fcllt ca. 20 ml Sprudelwasser in das Becherglas und f\u00e4rbt es mit 4 Tropfen\nIndikatorl\u00f6sung ein. \n2.) Gie\u00dft davon ca. 10 ml in ein Reagenzglas und ordnet der Farbe der L\u00f6sung mit Hilfe der\nFarbkarte den richtigen pH-Wert zu. \n3.) Stellt das Becherglas mit der restlichen L\u00f6sung auf die Heizplatte. \n4.) Steckt die Heizplatte ein und erhitzt das Wasser unter st\u00e4ndigem R\u00fchren f\u00fcr ca. 2 min\nbis eine eindeutige \u00c4nderung der Farbe eintritt. Beobachtet, welche Farb\u00e4nderung der\nL\u00f6sung eintritt. \n5.) Schaltet nun die Heizplatte aus und f\u00fcllt die warme L\u00f6sung um in ein zweites\nReagenzglas. Vorsicht: Becherglas nur oben am Rand anfassen! \n6.) Ordnet der erhitzten L\u00f6sung den pH-Wert zu und notiert ihn. \n7.) Gie\u00dft die Fl\u00fcssigkeiten ins Waschbecken.  ","fontSize":8.258344761824828,"fontFamily":6,"textAlign":"left","verticalAlign":"middle","containerId":"asykhI_265XWZuXaJnKK7","originalText":"Experiment H: Temperatur, Wasser und CO2\n\nAnleitung: \n1.) F\u00fcllt ca. 20 ml Sprudelwasser in das Becherglas und f\u00e4rbt es mit 4 Tropfen Indikatorl\u00f6sung ein. \n2.) Gie\u00dft davon ca. 10 ml in ein Reagenzglas und ordnet der Farbe der L\u00f6sung mit Hilfe der Farbkarte den richtigen pH-Wert zu. \n3.) Stellt das Becherglas mit der restlichen L\u00f6sung auf die Heizplatte. \n4.) Steckt die Heizplatte ein und erhitzt das Wasser unter st\u00e4ndigem R\u00fchren f\u00fcr ca. 2 min bis eine eindeutige \u00c4nderung der Farbe eintritt. Beobachtet, welche Farb\u00e4nderung der L\u00f6sung eintritt. \n5.) Schaltet nun die Heizplatte aus und f\u00fcllt die warme L\u00f6sung um in ein zweites Reagenzglas. Vorsicht: Becherglas nur oben am Rand anfassen! \n6.) Ordnet der erhitzten L\u00f6sung den pH-Wert zu und notiert ihn. \n7.) Gie\u00dft die Fl\u00fcssigkeiten ins Waschbecken.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"-xgCxSVR0C507ttdJ9O2C","type":"rectangle","x":-1096.6850118463194,"y":450.41417281425083,"width":137.08395838534534,"height":98.97092543238945,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3y","roundness":null,"seed":386622446,"version":404,"versionNonce":1517743463,"isDeleted":false,"boundElements":[{"type":"text","id":"7IHPuL7idbZObKyCIiVf2"},{"id":"GEKMxU-PzMfRoIs9rPLgK","type":"arrow"}],"updated":1794410114082,"created":1791538583208,"link":"https://www.geogebra.org/m/r8gny4uc","locked":false},{"id":"7IHPuL7idbZObKyCIiVf2","type":"text","x":-1089.5130315855315,"y":465.39813214613866,"width":122.73999786376953,"height":69.00300676861374,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3yG","roundness":null,"seed":1780491058,"version":408,"versionNonce":264205097,"isDeleted":false,"boundElements":[],"updated":1794409951311,"created":1791538583950,"link":null,"locked":false,"text":"Aufgabe 2: Erschlie\u00dft euch den\nZusammenhang, indem ihr den\nL\u00fcckentext l\u00f6st, der sich beim\nTippen auf diese Kachel \u00f6ffnet.\n\n\u00dcbertragt die L\u00fccken ins\nProjektheft, wenn alles richtig ist.  ","fontSize":7.886057916413001,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"-xgCxSVR0C507ttdJ9O2C","originalText":"Aufgabe 2: Erschlie\u00dft euch den Zusammenhang, indem ihr den L\u00fcckentext l\u00f6st, der sich beim Tippen auf diese Kachel \u00f6ffnet.\n\n\u00dcbertragt die L\u00fccken ins Projektheft, wenn alles richtig ist.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"VpuFy3y8SpmHwwF4PrCh_","type":"rectangle","x":-923.5353449172878,"y":206.343294142981,"width":195.17318518877207,"height":188.4921508844234,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3yV","roundness":null,"seed":729801518,"version":193,"versionNonce":446962793,"isDeleted":false,"boundElements":[{"type":"text","id":"TlmU2TaRuTKePWJQwoHss"},{"id":"GEKMxU-PzMfRoIs9rPLgK","type":"arrow"},{"id":"ew3lyVh1123yytN64Dyzv","type":"arrow"}],"updated":1794410118496,"created":1791538599759,"link":"https://www.geogebra.org/m/fe66jkmb","locked":false},{"id":"TlmU2TaRuTKePWJQwoHss","type":"text","x":-915.2287511021987,"y":232.55962120755333,"width":178.55999755859375,"height":136.0594967552787,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b3z","roundness":null,"seed":1948993262,"version":244,"versionNonce":666517993,"isDeleted":false,"boundElements":[],"updated":1794410025185,"created":1791538600587,"link":null,"locked":false,"text":"Mit steigenden Temperaturen durch die globale\nErw\u00e4rmung ist das Meer als CO2-Speicher also\nimmer ineffektiver, genau wie eine Limo in der\nsommerlichen Hitze schnell den Sprudel verliert.\nDadurch ist mehr CO2 in der Atmosph\u00e4re, welches\nals Treibhausgas die globale Erw\u00e4rmung\nbeeinflusst. Es entsteht ein Kreislauf.\n\nAufgabe 3: Ordnet nun die einzelnen Schritte, um\nden Kreislauf darzustellen. \u00d6ffnet daf\u00fcr die\nAktivit\u00e4t, indem ihr auf diese Kachel tippt.\n\n\u00dcbertragt die L\u00fccken wieder ins Projektheft, wenn\nalles richtig ist.  ","fontSize":7.774828386015926,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"VpuFy3y8SpmHwwF4PrCh_","originalText":"Mit steigenden Temperaturen durch die globale Erw\u00e4rmung ist das Meer als CO2-Speicher also immer ineffektiver, genau wie eine Limo in der sommerlichen Hitze schnell den Sprudel verliert. Dadurch ist mehr CO2 in der Atmosph\u00e4re, welches als Treibhausgas die globale Erw\u00e4rmung beeinflusst. Es entsteht ein Kreislauf.\n\nAufgabe 3: Ordnet nun die einzelnen Schritte, um den Kreislauf darzustellen. \u00d6ffnet daf\u00fcr die Aktivit\u00e4t, indem ihr auf diese Kachel tippt.\n\n\u00dcbertragt die L\u00fccken wieder ins Projektheft, wenn alles richtig ist.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"KI2AYegzG6bTTH-5Q9uQm","type":"rectangle","x":-692.4640660060686,"y":82.035216689621,"width":95.57378413282004,"height":74.14850508871675,"angle":0,"strokeColor":"transparent","backgroundColor":"#dab1e8","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b3zV","roundness":null,"seed":1557183598,"version":294,"versionNonce":2137738407,"isDeleted":false,"boundElements":[{"type":"text","id":"PwQIuA7v2qLHoWrDNuY7B"},{"id":"ew3lyVh1123yytN64Dyzv","type":"arrow"},{"id":"tB5dOSLfpOkuq6jytFk3k","type":"arrow"}],"updated":1794410121705,"created":1791538608471,"link":null,"locked":false},{"id":"PwQIuA7v2qLHoWrDNuY7B","type":"text","x":-684.8471721086039,"y":92.48952495923015,"width":80.33999633789062,"height":53.239888549498446,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b40","roundness":null,"seed":616632370,"version":250,"versionNonce":1930786279,"isDeleted":false,"boundElements":[],"updated":1794410033298,"created":1791538609077,"link":null,"locked":false,"text":"Nun kennt ihr die\nZusammenh\u00e4nge und\nk\u00f6nnt euch selbst\n\u00fcberlegen, ob die Meere\nallein unser bestehendes\nProblem l\u00f6sen k\u00f6nnten.  ","fontSize":7.098651806599793,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"KI2AYegzG6bTTH-5Q9uQm","originalText":"Nun kennt ihr die Zusammenh\u00e4nge und k\u00f6nnt euch selbst \u00fcberlegen, ob die Meere allein unser bestehendes Problem l\u00f6sen k\u00f6nnten.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"p7p9e8acKEeybVvBGZalM","type":"rectangle","x":-760.2744937271486,"y":-227.26554942246617,"width":186.6284925197148,"height":186.6284925197148,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffe980","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b42","roundness":null,"seed":1368067570,"version":135,"versionNonce":684032807,"isDeleted":false,"boundElements":[{"type":"text","id":"kbBYC_obLJw_ituLdRmcF"},{"id":"pOVPwHYmM9ff1PC4_RCgj","type":"arrow"},{"id":"GlwzNGwqO9PBDX9GUV1n8","type":"arrow"}],"updated":1794409301877,"created":1791539259406,"link":null,"locked":false},{"id":"kbBYC_obLJw_ituLdRmcF","type":"text","x":-753.1202511294006,"y":-205.88234168068988,"width":172.32000732421875,"height":143.86207703616225,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b43","roundness":null,"seed":155719474,"version":104,"versionNonce":780371655,"isDeleted":false,"boundElements":[],"updated":1794409292854,"created":1791539260102,"link":null,"locked":false,"text":"Wir sind das einzige Land ohne\ngenerelles Tempolimit auf den\nAutobahnen. Die Einf\u00fchrung wird\nimmer wieder diskutiert. \n\nScheinbar gibt es einen Unterschied,\nwenn Autos mit unterschiedlichen\nGeschwindigkeiten fahren. Neben\nSicherheitsaspekten spielt der\nKraftstoffverbrauch eine wichtige\nRolle.  ","fontSize":10.46269651172089,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"p7p9e8acKEeybVvBGZalM","originalText":"Wir sind das einzige Land ohne generelles Tempolimit auf den Autobahnen. Die Einf\u00fchrung wird immer wieder diskutiert. \n\nScheinbar gibt es einen Unterschied, wenn Autos mit unterschiedlichen Geschwindigkeiten fahren. Neben Sicherheitsaspekten spielt der Kraftstoffverbrauch eine wichtige Rolle.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"gnVikmiSdzz0z-O47C58-","type":"rectangle","x":-1515.0716186450525,"y":-69.86316850465835,"width":340.2418210822306,"height":364.6169098060595,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffe980","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b48","roundness":null,"seed":1320690030,"version":233,"versionNonce":1929629383,"isDeleted":false,"boundElements":[{"id":"6c45yMgJsd9PpLk9eqYy5","type":"text"},{"id":"xbMLKR12XemX1X998VPE1","type":"arrow"},{"id":"gBbJdwEDSx-icBoyvpnSy","type":"arrow"}],"updated":1794409309284,"created":1791539286788,"link":null,"locked":false},{"id":"6c45yMgJsd9PpLk9eqYy5","type":"text","x":-1496.7807099349918,"y":-64.86316850465835,"width":303.6600036621094,"height":169.10365510412413,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b49","roundness":null,"seed":866163058,"version":184,"versionNonce":821244841,"isDeleted":false,"boundElements":[],"updated":1794408877936,"created":1791539287507,"link":null,"locked":false,"text":"\nNun wisst ihr, wie man mit bewussten Entscheidungen\nCO2 im Verkehr einsparen kann. \n\nAuch f\u00fcr andere Aspekte in unserem Leben ist es recht\neinfach das erzeugte CO2 zu reduzieren, welches im\nZusammenhang mit dem eigenen Lebensstandard\n(Wohnung, Essen, Kleidung) erzeugt wird.\n\nEin Weg ist die Hilfe von Apps zu nutzen. Das wird im\nFolgenden Video einmal vorgestellt. ","fontSize":12.298447643936301,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"gnVikmiSdzz0z-O47C58-","originalText":"\nNun wisst ihr, wie man mit bewussten Entscheidungen CO2 im Verkehr einsparen kann. \n\nAuch f\u00fcr andere Aspekte in unserem Leben ist es recht einfach das erzeugte CO2 zu reduzieren, welches im Zusammenhang mit dem eigenen Lebensstandard (Wohnung, Essen, Kleidung) erzeugt wird.\n\nEin Weg ist die Hilfe von Apps zu nutzen. Das wird im Folgenden Video einmal vorgestellt. ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"JphcwLJD_o7sRrShKCaU-","type":"rectangle","x":-1919.8118939155154,"y":83.05214460330023,"width":262.7636926969337,"height":167.43905202781997,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffe980","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4A","roundness":null,"seed":1576600366,"version":446,"versionNonce":1699505321,"isDeleted":false,"boundElements":[{"type":"text","id":"KiIRw4vxuOULLgAlTwUCV"},{"id":"gBbJdwEDSx-icBoyvpnSy","type":"arrow"},{"id":"FmtoS52Ra6AiboK0PeLV9","type":"arrow"}],"updated":1794409318307,"created":1791539309544,"link":"https://interaktiv.tagesspiegel.de/lab/co2-bilanz-von-essen-der-klimarechner-fuer-deine-kueche/","locked":false},{"id":"KiIRw4vxuOULLgAlTwUCV","type":"text","x":-1914.3600478722244,"y":96.54303909447016,"width":251.86000061035156,"height":140.45726304548012,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4B","roundness":null,"seed":710867826,"version":516,"versionNonce":317840039,"isDeleted":false,"boundElements":[],"updated":1794408981741,"created":1791539310413,"link":null,"locked":false,"text":"Die globale Erderw\u00e4rmung zu stoppen ist wichtig f\u00fcr die\nZukunft, damit selbst die Kinder unserer Kinder auf keiner\nzerst\u00f6rten Erde leben m\u00fcssen. Im Video wurde eine Anpassung\nder Ern\u00e4hrung als M\u00f6glichkeit des pers\u00f6nlichen Umweltschutzes\nangesprochen.\n\nAufgabe 2: Untersucht auf der folgenden Website 3 Gerichte\nund ihre CO2 Bilanz pro Portion. Zieht Schlussfolgerungen,\nwelche Lebensmittel gut bzw. schlecht f\u00fcrs Klima sind und ob es\n\u00fcberhaupt Alternativen gibt.\n\nDie Website \u00f6ffnet sich, wenn ihr auf diese Kachel tippt. Notiert\neure Ergebnisse im Projektheft.","fontSize":8.643523879721853,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"JphcwLJD_o7sRrShKCaU-","originalText":"Die globale Erderw\u00e4rmung zu stoppen ist wichtig f\u00fcr die Zukunft, damit selbst die Kinder unserer Kinder auf keiner zerst\u00f6rten Erde leben m\u00fcssen. Im Video wurde eine Anpassung der Ern\u00e4hrung als M\u00f6glichkeit des pers\u00f6nlichen Umweltschutzes angesprochen.\n\nAufgabe 2: Untersucht auf der folgenden Website 3 Gerichte und ihre CO2 Bilanz pro Portion. Zieht Schlussfolgerungen, welche Lebensmittel gut bzw. schlecht f\u00fcrs Klima sind und ob es \u00fcberhaupt Alternativen gibt.\n\nDie Website \u00f6ffnet sich, wenn ihr auf diese Kachel tippt. Notiert eure Ergebnisse im Projektheft.","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"3GvXC3nh8i6Ni2TxqKIQb","type":"rectangle","x":-1825.4008910295704,"y":-354.00662800137854,"width":208.55860656473277,"height":266.8085141883362,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffe980","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4E","roundness":null,"seed":733748018,"version":358,"versionNonce":1555681897,"isDeleted":false,"boundElements":[{"type":"text","id":"6AVN8t23GiidmUXtBWsG-"},{"id":"okshMejya5a5cqA3a7D9m","type":"arrow"},{"id":"PJeZpGE_LbZO7LejlT8Wc","type":"arrow"}],"updated":1794409361139,"created":1791539346497,"link":null,"locked":false},{"id":"6AVN8t23GiidmUXtBWsG-","type":"text","x":-1816.671590798962,"y":-349.00662800137854,"width":191.10000610351562,"height":86.2539715992898,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4F","roundness":null,"seed":1742452722,"version":222,"versionNonce":237466343,"isDeleted":false,"boundElements":[],"updated":1794409185665,"created":1791539347367,"link":null,"locked":false,"text":"\nEine \u00dcbersicht der durchschnittlichen Emissionen pro\ndeutschem Staatsb\u00fcrger gibt der sogenannte CO2-\nFu\u00dfabdruck.\n\nAufgabe 3: Schaut euch den Fu\u00dfabdruck an und erkl\u00e4rt\nim Projektheft, wie ihr allgemein pers\u00f6nlich CO2\neinsparen k\u00f6nntet und welchen Einfluss die Ma\u00dfnahme\nauf euer Leben h\u00e4tte.  ","fontSize":7.6670196977146485,"fontFamily":6,"textAlign":"center","verticalAlign":"top","containerId":"3GvXC3nh8i6Ni2TxqKIQb","originalText":"\nEine \u00dcbersicht der durchschnittlichen Emissionen pro deutschem Staatsb\u00fcrger gibt der sogenannte CO2-Fu\u00dfabdruck.\n\nAufgabe 3: Schaut euch den Fu\u00dfabdruck an und erkl\u00e4rt im Projektheft, wie ihr allgemein pers\u00f6nlich CO2 einsparen k\u00f6nntet und welchen Einfluss die Ma\u00dfnahme auf euer Leben h\u00e4tte.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"m07nV1GgG5NrqqYEkGqK1","type":"rectangle","x":-1522.439751778639,"y":-445.0949082636447,"width":223.80731118729233,"height":122.34024024334784,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffe980","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4G","roundness":null,"seed":1150605230,"version":241,"versionNonce":832199015,"isDeleted":false,"boundElements":[{"type":"text","id":"LGo3GAENG8ohDh2i8hgnz"},{"id":"ZmF1HGUpjSPAIvGiqpIOF","type":"arrow"}],"updated":1794409329339,"created":1791539359638,"link":null,"locked":false},{"id":"LGo3GAENG8ohDh2i8hgnz","type":"text","x":-1516.1260925228835,"y":-435.7705676138524,"width":211.17999267578125,"height":103.69155894376327,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4H","roundness":null,"seed":278820014,"version":173,"versionNonce":1120073415,"isDeleted":false,"boundElements":[],"updated":1794409253293,"created":1791539360388,"link":null,"locked":false,"text":"Wenn jeder Mensch seinen Beitrag zur\nSenkung der CO2-Emission beitragen w\u00fcrde,\nw\u00fcrde die globale Erw\u00e4rmung abgebremst\nwerden.\n\nUm die Erderw\u00e4rmung aber komplett zu\nstoppen, m\u00fcsste auch die Politik mehr\nunternehmen.  ","fontSize":10.369155894376327,"fontFamily":6,"textAlign":"center","verticalAlign":"middle","containerId":"m07nV1GgG5NrqqYEkGqK1","originalText":"Wenn jeder Mensch seinen Beitrag zur Senkung der CO2-Emission beitragen w\u00fcrde, w\u00fcrde die globale Erw\u00e4rmung abgebremst werden.\n\nUm die Erderw\u00e4rmung aber komplett zu stoppen, m\u00fcsste auch die Politik mehr unternehmen.  ","autoResize":true,"lineHeight":1.25,"labelPosition":null,"baseFontSize":null},{"id":"cefBqTIkfUyjD4KBXw8t2","type":"rectangle","x":-1210.024722722956,"y":-503.5866796818168,"width":411.66322082481173,"height":312.0422246017072,"angle":0,"strokeColor":"transparent","backgroundColor":"#ffe980","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b4I","roundness":null,"seed":2047012466,"version":264,"versionNonce":2146353127,"isDeleted":false,"boundElements":[{"type":"text","id":"tIYE1E65ALLRpoUXYBZO6"},{"id":"ZmF1HGUpjSPAIvGiqpIOF","type":"arrow"},{"id":"s-eYKXUJ5LVKT8kV5IyuJ","type":"arrow"}],"updated":1794409333153,"created":1791539371459,"link":null,"locked":false},{"id":"tIYE1E65ALLRpoUXYBZO6","type":"text","x":-1197.9031190244175,"y":-498.5866796818168,"width":387.4200134277344,"height":90.70899311568476,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"b4J","roundness":null,"seed":1377108338,"version":202,"versionNonce":1028214857,"isDeleted":false,"boundElements":[],"updated":1794409290160,"created":1791539372291,"link":null,"locked":false,"text":"\nAufgabe 4: \nBetrachtet die Anteile der Sektoren an der CO2-Emission in Abbildung\n25. Sucht euch einen oder mehrere Sektoren aus und beschreibt im\nProjektheft, wie